# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Credentials
# IMPORTANT: Change these in production!
ADMIN_PASSWORD=change_me_in_production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Olira Agro Industry
RECIPIENT_EMAIL=info@oliraagroindustry.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.40.225:3000

# JWT Secret (>=32 chars in production; rotating it invalidates all sessions)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Reverse proxy hops in front of Node (cPanel/Apache/Passenger = 1, add 1 if
# also behind Cloudflare, etc.). Required for correct client-IP detection so
# rate limiting and login lockout can't be bypassed by spoofing X-Forwarded-For.
TRUST_PROXY=1

# Persistent storage (recommended for cPanel/containers).
# Point these at an absolute path OUTSIDE the deploy directory so admin-managed
# content and uploaded images survive redeploys. On first boot an empty DATA_DIR
# is seeded from the repo defaults. Leave unset to use the in-repo ./data and
# ./public/uploads (fine for local dev).
# DATA_DIR=/home/youruser/olira-persistent/data
# UPLOADS_DIR=/home/youruser/olira-persistent/uploads
