# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Credentials
# IMPORTANT: Change these in production!
ADMIN_PASSWORD=change_me_in_production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Olira Agro Industry
RECIPIENT_EMAIL=info@oliraagroindustry.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.40.225:3000

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database
DATABASE_PATH=./data/olira.db
