{
  "name": "olira-agro",
  "version": "2.0.0",
  "description": "Olira Agro website with self-hosted infrastructure",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:astro\" \"npm run dev:api\"",
    "dev:astro": "astro dev",
    "dev:api": "node server.js",
    "build": "astro build && node scripts/convert-to-webp.mjs public",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "start": "node server.js"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.1"
  }
}
