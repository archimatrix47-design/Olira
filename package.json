{
  "name": "olira-agro",
  "version": "2.0.0",
  "description": "Olira Agro website with self-hosted infrastructure",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:astro\" \"npm run dev:api\"",
    "dev:astro": "astro dev",
    "dev:api": "node server.js --port 3000",
    "build": "astro build && node scripts/convert-to-webp.mjs public && node scripts/precompress.mjs",
    "test": "node --test",
    "test:pipeline": "node --test scripts/pipeline-test.mjs",
    "boxes": "node scripts/boxes.mjs",
    "boxes:check": "node scripts/boxes.mjs --check",
    "box:new": "node scripts/boxes.mjs new",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "start": "node server.js"
  },
  "dependencies": {
    "astro": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "terser": "^5.46.1"
  }
}
