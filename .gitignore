# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock
# package-lock.json is deliberately COMMITTED. The server installs with
# `npm ci`, which requires it and installs the exact versions tested here.
# Without it, a deploy resolves fresh versions of everything — including
# sharp, a native binary — so production would run untested dependencies.

# Environment variables (sensitive configuration)
.env
.env.local
.env.*.local

# Email configuration (contains SMTP credentials)
email-config.json

# Astro build artifacts
dist/
.astro/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Testing
.nyc_output/
coverage/

# Logs
logs/
*.log
npm-debug.log*

# Development
.cache/
tmp/
temp/

# Claude Code working files
CLAUDE.md
.claude/

# Runtime analytics data (regenerated constantly; not source)
data/analytics.json
src/data/burayu-grid.cache.json
