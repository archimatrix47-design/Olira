---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---
<SiteLayout title="Page not found, Olira Agro Industry" description="The page you are looking for could not be found." noindex>
  <SiteHeader groups={[[{ href: '/agriculture/', label: 'Agriculture' }, { href: '/packaging/', label: 'Packaging' }]]} />
  <main id="main">
    <section class="lost">
      <div class="wrap">
        <span class="big" aria-hidden="true">404</span>
        <h1>We could not find that page</h1>
        <p class="sub">The link may be old, or the page has moved. Choose where you want to go.</p>
        <div class="acts">
          <a class="act fill" href="/agriculture/">Agricultural exports</a>
          <a class="act" href="/packaging/">Printed packaging</a>
          <a class="act" href="/">Home</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter note="Olira Agro Industry, Addis Ababa." />
  <script>import '../scripts/common.js'; import '../scripts/motion.js';</script>
</SiteLayout>
