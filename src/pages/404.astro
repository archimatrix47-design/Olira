---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found - Olira Agro Industry" description="The page you're looking for could not be found.">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-primary-50 to-white">
    <div class="text-center px-6 max-w-2xl mx-auto">
      <!-- Error Code -->
      <div class="text-8xl font-bold text-primary-900 mb-4">404</div>

      <!-- Error Message -->
      <h1 class="font-heading text-4xl font-bold text-primary-900 mb-4">Page Not Found</h1>
      <p class="text-lg text-primary-700 mb-8">
        Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
      </p>

      <!-- Navigation Links -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href="/"
          class="inline-block bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 font-bold rounded transition transform hover:scale-105"
        >
          Go Home
        </a>
        <a
          href="/#products"
          class="inline-block border-2 border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white px-8 py-3 font-bold rounded transition"
        >
          View Products
        </a>
        <a
          href="/#contact"
          class="inline-block border-2 border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white px-8 py-3 font-bold rounded transition"
        >
          Contact Us
        </a>
      </div>

      <!-- Helpful Information -->
      <div class="bg-primary-50 border-l-4 border-primary-600 p-6 text-left rounded">
        <h2 class="font-bold text-primary-900 mb-2">What can you do?</h2>
        <ul class="text-primary-700 space-y-2 text-sm">
          <li>✓ Check if the URL is correct</li>
          <li>✓ Return to the home page and navigate using the menu</li>
          <li>✓ Use the search function if available</li>
          <li>✓ Contact us if you believe this is an error</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    h1 {
      animation: slideUp 0.8s ease-out;
    }

    .bg-primary-50 {
      animation: fadeIn 0.8s ease-out 0.2s backwards;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
