---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icons.astro';
---

<BaseLayout title="Admin Dashboard | Olira Agro Industry">
  <div class="pt-32 pb-20 bg-gray-50 min-h-screen">
    <div class="container mx-auto">
      <!-- Admin Header with Navigation -->
      <div class="mb-12 animate-slideUp">
        <div class="flex items-center justify-between mb-6">
          <a href="/" class="inline-flex items-center gap-3 hover:opacity-75 transition">
            <div class="w-10 h-10 bg-primary-900 rounded flex items-center justify-center">
              <Icon name="home" size={20} class="text-white" />
            </div>
            <span class="font-heading text-lg font-bold text-primary-900">Back to Home</span>
          </a>
          <a href="/admin-integrations" class="inline-flex items-center gap-2 px-4 py-2 border-2 border-primary-300 text-primary-900 font-bold rounded-lg hover:bg-primary-50 transition">
            <Icon name="chart" size={18} />
            <span>Marketing Integrations</span>
          </a>
        </div>
        <h1 class="font-heading text-5xl font-bold text-primary-900 mb-3">Admin Dashboard</h1>
        <p class="text-xl text-primary-900">Manage website content, products, and images</p>
      </div>

      <!-- Login Section (if not authenticated) -->
      <div id="loginSection" class="max-w-md mx-auto mb-12">
        <div class="bg-white border-2 border-primary-300 p-10 shadow-lg">
          <div class="flex items-center justify-center w-12 h-12 bg-gradient-green rounded-xl mx-auto mb-8">
            <Icon name="certified" size={24} class="text-white" />
          </div>

          <h2 class="font-heading text-2xl font-bold text-primary-900 mb-2 text-center">Admin Access</h2>
          <p class="text-primary-900 text-center text-sm mb-8">Enter password to access dashboard</p>

          <form id="loginForm" class="space-y-6">
            <div>
              <label for="password" class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">PASSWORD</label>
              <input
                type="password"
                id="password"
                placeholder="••••••••"
                class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white text-primary-900 placeholder-primary-400 transition outline-none"
              />
              <p class="text-primary-600 text-xs mt-2">Contact administrator for credentials</p>
            </div>
            <button type="submit" class="w-full bg-primary-900 hover:bg-primary-800 text-white px-8 py-4 font-bold transition transform hover:-translate-y-1 flex items-center justify-center gap-2">
              <Icon name="checkmark" size={20} />
              LOGIN
            </button>
          </form>
        </div>
      </div>

      <!-- Admin Panel (hidden by default) -->
      <div id="adminPanel" class="hidden space-y-12">
        <!-- Header with Logout -->
        <div class="flex justify-between items-center mb-8 pb-8 border-b-2 border-primary-200">
          <div>
            <h2 class="font-heading text-3xl font-bold text-primary-900">Dashboard</h2>
            <p class="text-primary-600 text-sm">Welcome back! Manage your website content</p>
          </div>
          <button id="logoutBtn" class="flex items-center gap-2 px-6 py-3 border-2 border-red-600 text-red-600 font-bold hover:bg-red-50 transition">
            <Icon name="close" size={20} />
            LOGOUT
          </button>
        </div>

        <!-- Tab Navigation -->
        <div class="flex gap-2 border-b-2 border-primary-200 mb-12 overflow-x-auto">
          <button id="tabAnalytics" class="px-6 py-4 font-bold text-primary-900 border-b-4 border-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="chart" size={20} />
            ANALYTICS
          </button>
          <button id="tabProducts" class="px-6 py-4 font-bold text-primary-600 hover:text-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="package" size={20} />
            PRODUCTS
          </button>
          <button id="tabBranding" class="px-6 py-4 font-bold text-primary-600 hover:text-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="upload" size={20} />
            BRANDING
          </button>
          <button id="tabEmail" class="px-6 py-4 font-bold text-primary-600 hover:text-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="email" size={20} />
            EMAIL
          </button>
          <button id="tabContent" class="px-6 py-4 font-bold text-primary-600 hover:text-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="edit" size={20} />
            CONTENT
          </button>
          <button id="tabSocial" class="px-6 py-4 font-bold text-primary-600 hover:text-primary-900 whitespace-nowrap flex items-center gap-2 transition">
            <Icon name="handshake" size={20} />
            SOCIAL
          </button>
        </div>

        <!-- ANALYTICS TAB (default view) -->
        <div id="analyticsTab" class="space-y-10">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h3 class="font-heading text-2xl font-bold text-primary-900">Website Analytics</h3>
              <p class="text-primary-600 text-sm mt-1">
                First-party, cookie-free. No IP addresses or personal data are stored — visitors are counted with a daily-rotating anonymous hash.
              </p>
            </div>
            <div class="flex items-center gap-2">
              <label for="analyticsRange" class="text-xs font-bold tracking-wider text-primary-600 uppercase">Range</label>
              <select id="analyticsRange" class="px-3 py-2 border-2 border-primary-200 focus:border-primary-600 bg-white font-medium outline-none">
                <option value="7">Last 7 days</option>
                <option value="30" selected>Last 30 days</option>
                <option value="90">Last 90 days</option>
              </select>
              <button id="analyticsRefresh" type="button" class="px-4 py-2 border-2 border-primary-600 text-primary-600 hover:bg-primary-50 font-bold text-sm transition">
                Refresh
              </button>
            </div>
          </div>

          <!-- KPI cards -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white border-2 border-primary-200 p-6">
              <p class="text-[10px] font-bold tracking-[0.18em] uppercase text-primary-600">Page views</p>
              <p id="kpiViews" class="font-heading text-4xl font-bold text-primary-900 mt-2">–</p>
            </div>
            <div class="bg-white border-2 border-primary-200 p-6">
              <p class="text-[10px] font-bold tracking-[0.18em] uppercase text-primary-600">Visitors</p>
              <p id="kpiUniques" class="font-heading text-4xl font-bold text-primary-900 mt-2">–</p>
            </div>
            <div class="bg-white border-2 border-primary-200 p-6">
              <p class="text-[10px] font-bold tracking-[0.18em] uppercase text-primary-600">Inquiries</p>
              <p id="kpiInquiries" class="font-heading text-4xl font-bold text-primary-900 mt-2">–</p>
            </div>
            <div class="bg-white border-2 border-primary-200 p-6">
              <p class="text-[10px] font-bold tracking-[0.18em] uppercase text-primary-600">Conversion</p>
              <p id="kpiConversion" class="font-heading text-4xl font-bold text-primary-900 mt-2">–</p>
            </div>
          </div>

          <!-- Daily chart -->
          <div class="bg-white border-2 border-primary-200 p-6">
            <div class="flex items-center justify-between mb-6">
              <h4 class="font-bold text-primary-900">Daily traffic</h4>
              <div class="flex items-center gap-4 text-xs text-primary-600">
                <span class="flex items-center gap-2"><span class="inline-block w-3 h-3 bg-primary-600"></span>Views</span>
                <span class="flex items-center gap-2"><span class="inline-block w-3 h-3 bg-teal-accent"></span>Visitors</span>
              </div>
            </div>
            <div id="analyticsChart" class="w-full overflow-x-auto"></div>
          </div>

          <!-- Breakdown tables -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="bg-white border-2 border-primary-200 p-6">
              <h4 class="font-bold text-primary-900 mb-4">Top pages</h4>
              <div id="analyticsPages" class="space-y-2 text-sm text-primary-800"></div>
            </div>
            <div class="bg-white border-2 border-primary-200 p-6">
              <h4 class="font-bold text-primary-900 mb-4">Top referrers</h4>
              <div id="analyticsReferrers" class="space-y-2 text-sm text-primary-800"></div>
            </div>
            <div class="bg-white border-2 border-primary-200 p-6">
              <h4 class="font-bold text-primary-900 mb-4">Devices</h4>
              <div id="analyticsDevices" class="space-y-2 text-sm text-primary-800"></div>
            </div>
          </div>

          <!-- Product interest: which products visitors actually click on, and
               how many of those turned into a sent inquiry. -->
          <div class="bg-white border-2 border-primary-200 p-6 mt-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
              <h4 class="font-bold text-primary-900">Product interest</h4>
              <div class="flex items-center gap-4 text-xs text-primary-600">
                <span class="flex items-center gap-2"><span class="inline-block w-3 h-3 bg-primary-600"></span>Quote clicks</span>
                <span class="flex items-center gap-2"><span class="inline-block w-3 h-3 bg-teal-accent"></span>Inquiries sent</span>
              </div>
            </div>
            <p class="text-xs text-primary-500 mb-4">How often each product card's "Request quote" button was clicked, and how many inquiries named that product.</p>
            <div id="analyticsProducts" class="space-y-3 text-sm text-primary-800"></div>
          </div>

          <p id="analyticsEmpty" class="hidden text-center text-primary-600 py-8">
            No traffic recorded yet for this range. Visit the public site in another tab and refresh this page.
          </p>
        </div>

        <!-- PRODUCTS TAB -->
        <div id="productsTab" class="hidden space-y-12">
          <div class="flex items-center justify-between">
            <h3 class="font-heading text-2xl font-bold text-primary-900">Manage Products</h3>
            <button id="productsRefreshBtn" type="button" class="text-sm text-primary-600 hover:text-primary-900 underline">Refresh</button>
          </div>

          <!-- Add / Edit Product Form -->
          <div class="bg-white border-2 border-primary-300 p-10">
            <h4 id="productFormTitle" class="font-heading text-xl font-bold text-primary-900 mb-8 flex items-center gap-3">
              <Icon name="save" size={24} />
              Add Product
            </h4>
            <form id="productForm" class="space-y-6">
              <input type="hidden" id="productId" />

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productName">PRODUCT NAME *</label>
                <input id="productName" type="text" required placeholder="e.g., Natural Sesame Seeds" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productDescription">DESCRIPTION *</label>
                <textarea id="productDescription" rows="4" required placeholder="Describe the product..." class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none resize-none"></textarea>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productPurity">PURITY</label>
                  <input id="productPurity" type="text" placeholder="99.95%" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productMoq">MOQ</label>
                  <input id="productMoq" type="text" placeholder="10 MT" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productCategory">CATEGORY</label>
                  <input id="productCategory" type="text" placeholder="Sesame" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="productSpecs">SPECS (one per line, max 20)</label>
                <textarea id="productSpecs" rows="4" placeholder="Humera variety&#10;High oil content (50%+)&#10;Creamy color&#10;ISO 22000 certified" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none resize-none"></textarea>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="smtpHost">PRODUCT IMAGE (optional, auto-resized to 1200px WebP)</label>
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0 w-32 h-32 bg-primary-50 border-2 border-primary-200 rounded flex items-center justify-center overflow-hidden">
                    <img id="productImagePreview" src="" alt="" class="max-w-full max-h-full object-contain" style="display:none;" />
                    <span id="productImagePlaceholder" class="text-primary-400 text-xs text-center px-2">No image</span>
                  </div>
                  <div class="flex-1">
                    <input type="file" id="productImageFile" accept="image/jpeg,image/png,image/webp,image/svg+xml" class="block text-sm" />
                    <p class="text-primary-600 text-xs mt-2">JPG / PNG / WebP / SVG. Max 10MB. Auto-converted to WebP @ 1200px wide.</p>
                    <button type="button" id="productImageClearBtn" class="mt-2 text-xs text-red-600 hover:underline" style="display:none;">Remove image</button>
                  </div>
                </div>
                <input type="hidden" id="productImagePath" />
              </div>

              <div class="flex gap-3">
                <button type="submit" id="productSaveBtn" class="flex-1 bg-primary-900 hover:bg-primary-800 text-white px-8 py-4 font-bold transition flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                  <Icon name="save" size={20} />
                  <span id="productSaveBtnLabel">SAVE PRODUCT</span>
                </button>
                <button type="button" id="productCancelEditBtn" class="px-6 py-4 border-2 border-primary-300 text-primary-900 font-bold hover:bg-primary-50 transition" style="display:none;">CANCEL</button>
              </div>
            </form>
          </div>

          <!-- Products List -->
          <div>
            <h4 class="font-heading text-xl font-bold text-primary-900 mb-6">
              Current Products (<span id="productCountLabel">0</span>)
            </h4>
            <div id="productsListContainer" class="space-y-4">
              <p class="text-primary-600 text-sm">Loading products...</p>
            </div>
          </div>
        </div>

        <!-- BRANDING TAB -->
        <div id="brandingTab" class="hidden space-y-12">
          <h3 class="font-heading text-2xl font-bold text-primary-900">Manage Branding</h3>

          <!-- Logo Upload -->
          <div class="bg-white border-2 border-primary-300 p-10">
            <h4 class="font-heading text-xl font-bold text-primary-900 mb-8 flex items-center gap-3">
              <Icon name="upload" size={24} />
              Company Logo
            </h4>
            <p class="text-primary-600 text-sm mb-8">Upload your company logo. It will appear in both the header and footer of your website.</p>

            <form id="logoForm" class="space-y-6">
              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">UPLOAD LOGO *</label>
                <div class="border-2 border-dashed border-primary-300 rounded p-8 text-center hover:border-primary-600 transition cursor-pointer">
                  <Icon name="upload" size={32} class="text-primary-600 mx-auto mb-3" />
                  <p class="text-primary-900 font-bold mb-1">Click to upload or drag and drop</p>
                  <p class="text-primary-600 text-sm">PNG, SVG, JPG (Max 2MB)</p>
                </div>
                <input type="file" id="logoInput" accept="image/*" class="w-full mt-4 px-4 py-3 border-2 border-primary-200" />
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">PREVIEW</label>
                <div class="w-full h-40 bg-primary-50 rounded border-2 border-primary-200 flex items-center justify-center p-4">
                  <img id="logoPreview" src="" alt="Logo Preview" class="max-h-full max-w-full object-contain" style="display:none;" />
                  <p id="logoPlaceholder" class="text-primary-600 text-sm">Logo preview will appear here</p>
                </div>
              </div>

              <button type="submit" class="w-full bg-primary-900 hover:bg-primary-800 text-white px-8 py-4 font-bold transition flex items-center justify-center gap-2">
                <Icon name="save" size={20} />
                SAVE LOGO
              </button>
            </form>
          </div>

          <!-- Current Logo Display -->
          <div class="bg-white border-2 border-primary-200 p-6">
            <h5 class="font-bold text-primary-900 mb-4">Current Logo</h5>
            <div class="w-full h-32 bg-primary-50 rounded border-2 border-primary-200 flex items-center justify-center p-4 mb-4">
              <img id="logoDisplay" src="" alt="Current Logo" class="max-h-full max-w-full object-contain" style="display:none;" />
              <p id="logoDisplayPlaceholder" class="text-primary-600 text-sm">No logo uploaded</p>
            </div>
            <button id="clearLogoBtn" class="w-full p-2 border-2 border-red-600 text-red-600 hover:bg-red-50 font-bold text-sm transition flex items-center justify-center gap-1" style="display:none;">
              <Icon name="delete" size={16} />
              CLEAR LOGO
            </button>
          </div>
        </div>

        <!-- EMAIL TAB -->
        <div id="emailTab" class="hidden space-y-12">
          <h3 class="font-heading text-2xl font-bold text-primary-900">Email Configuration</h3>

          <!-- SMTP Configuration -->
          <div class="bg-white border-2 border-primary-300 p-10">
            <h4 class="font-heading text-xl font-bold text-primary-900 mb-8 flex items-center gap-3">
              <Icon name="email" size={24} />
              SMTP Settings
            </h4>
            <form id="emailConfigForm" class="space-y-6">
              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">SMTP HOST *</label>
                <input type="text" id="smtpHost" name="smtpHost" placeholder="e.g., smtp.gmail.com" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                <p class="text-primary-600 text-xs mt-2">For Gmail: smtp.gmail.com | For Outlook: smtp-mail.outlook.com</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="smtpPort">SMTP PORT *</label>
                  <input type="number" id="smtpPort" name="smtpPort" placeholder="587 or 465" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                  <p class="text-primary-600 text-xs mt-2">587 = TLS, 465 = SSL</p>
                </div>

                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="fromName">FROM NAME</label>
                  <input type="text" id="fromName" name="fromName" placeholder="Olira Agro Industry" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="smtpUser">SMTP EMAIL ADDRESS *</label>
                <input type="email" id="smtpUser" name="smtpUser" placeholder="your-email@gmail.com" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                <p class="text-primary-600 text-xs mt-2">The email address used to send inquiries</p>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="smtpPassword">SMTP PASSWORD *</label>
                <input type="password" id="smtpPassword" name="smtpPassword" placeholder="••••••••" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                <p class="text-primary-600 text-xs mt-2">For Gmail: Use an App Password (not your regular password)</p>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="recipientEmail">RECIPIENT EMAIL ADDRESS *</label>
                <input type="email" id="recipientEmail" name="recipientEmail" placeholder="info@oliraagroindustry.com" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                <p class="text-primary-600 text-xs mt-2">Where product inquiries will be sent</p>
              </div>

              <button type="submit" class="w-full bg-primary-900 hover:bg-primary-800 text-white px-8 py-4 font-bold transition flex items-center justify-center gap-2">
                <Icon name="save" size={20} />
                SAVE EMAIL CONFIGURATION
              </button>
            </form>
          </div>

          <!-- Email Test -->
          <div class="bg-primary-50 border-2 border-primary-200 p-8 rounded-lg">
            <h4 class="font-heading text-lg font-bold text-primary-900 mb-4 flex items-center gap-2">
              <Icon name="info" size={20} class="text-primary-600" />
              Gmail Setup Guide
            </h4>
            <ol class="text-primary-900 text-sm space-y-2 ml-5 list-decimal">
              <li>Enable 2-Step Verification in your Google Account</li>
              <li>Go to myaccount.google.com/apppasswords</li>
              <li>Select "Mail" and "Windows Computer"</li>
              <li>Copy the generated 16-character password</li>
              <li>Paste it in the SMTP PASSWORD field above</li>
            </ol>
          </div>

          <!-- Configuration Status -->
          <div id="emailStatus" class="bg-green-50 border-2 border-green-200 p-6 rounded-lg hidden">
            <p class="text-green-900 font-bold flex items-center gap-2">
              <Icon name="checkmark" size={20} class="text-green-700" />
              Email configuration is active
            </p>
            <p class="text-green-700 text-sm mt-2">Inquiries will be sent to: <span id="statusEmail" class="font-mono"></span></p>
          </div>

          <div id="emailErrorStatus" class="bg-red-50 border-2 border-red-200 p-6 rounded-lg hidden">
            <p class="text-red-900 font-bold flex items-center gap-2">
              <Icon name="alert" size={20} class="text-red-700" />
              Email configuration incomplete
            </p>
            <p class="text-red-700 text-sm mt-2">Please configure SMTP settings above</p>
          </div>
        </div>

        <!-- CONTENT TAB -->
        <div id="contentTab" class="hidden space-y-12">
          <h3 class="font-heading text-2xl font-bold text-primary-900">Manage Website Content</h3>

          <!-- Company Info -->
          <div class="bg-white border-2 border-primary-300 p-10">
            <h4 class="font-heading text-xl font-bold text-primary-900 mb-8 flex items-center gap-3">
              <Icon name="edit" size={24} />
              Company Information
            </h4>
            <form class="space-y-6">
              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider" for="phoneNumbers">COMPANY TAGLINE</label>
                <input type="text" value="Producing, processing and packaging high quality agricultural products for export" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">PHONE</label>
                  <input type="text" value="+251-911 223619" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
                <div>
                  <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">EMAIL</label>
                  <input type="email" value="info@oliraagroindustry.com" class="w-full px-4 py-3 border-2 border-primary-200 focus:border-primary-600 bg-white transition outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-primary-900 mb-3 tracking-wider">LOCATION</label>
