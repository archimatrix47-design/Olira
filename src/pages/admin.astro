---
// Admin panel. One page; each section is a view picked from the URL hash
// (#overview, #enquiries, ...). All data comes from the same API the website
// reads, so changes here show on the site without a rebuild.
import '../styles/tokens.css';
import '../styles/ambient.css';
import '../styles/site.css';
import '../styles/admin.css';
import '../styles/admin-insights.css';
import ThemeButton from '../components/site/ThemeButton.astro';

const icon: Record<string, string> = {
  overview: '<path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z"/>',
  traffic: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  enquiries: '<path d="M4 4h16v12H5.2L4 17.2z"/><path d="M8 9h8M8 12h5"/>',
  products: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
  company: '<path d="M4 21V5l8-2v18M12 8l8 3v10M8 9h.01M8 13h.01M8 17h.01M16 14h.01M16 18h.01"/>',
  certifications: '<circle cx="12" cy="9" r="5"/><path d="M9 13.5L8 21l4-2 4 2-1-7.5"/>',
  logo: '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/>',
  social: '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  marketing: '<path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/>',
  security: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/>',
};
const nav = [
  { label: 'Daily', items: [['overview', 'Overview'], ['enquiries', 'Enquiries'], ['traffic', 'Traffic']] },
  { label: 'Website', items: [['products', 'Products'], ['company', 'Company details'], ['certifications', 'Certifications'], ['logo', 'Logo'], ['social', 'Social links']] },
  { label: 'Settings', items: [['email', 'Email delivery'], ['marketing', 'Marketing tags'], ['security', 'Password']] },
];
const Svg = (name: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<script is:inline>(function(){try{var s=localStorage.getItem('olira-theme');if(s==='dark'||s==='light')document.documentElement.setAttribute('data-theme',s);}catch(e){}})();</script>
<title>Admin, Olira Agro Industry</title>
<link rel="icon" type="image/png" href="/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
<a class="skip" href="#adminMain">Skip to content</a>

<header class="a-top">
  <a class="a-brand" href="/admin/"><img src="/logo.png" alt="Olira Agro Industry" width="68" height="32" data-brand-logo><span>Admin</span></a>
  <div class="a-top-actions">
    <a class="btn btn-ghost a-hide-sm" href="/" target="_blank" rel="noopener">View website</a>
    <ThemeButton />
    <button class="btn btn-secondary" type="button" id="signOut" hidden>Sign out</button>
  </div>
</header>

<!-- sign in -->
<main class="a-login" id="loginView" hidden>
  <form class="a-card a-login-card" id="loginForm" novalidate>
    <div>
      <h1>Sign in</h1>
      <p>Manage enquiries, products and company details for oliraagroindustry.com.</p>
    </div>
    <div class="a-field">
      <label for="password">Admin password</label>
      <div class="a-pass">
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required aria-describedby="loginError">
        <button class="btn btn-ghost btn-sm" type="button" id="togglePass" aria-pressed="false">Show</button>
      </div>
      <p class="err" id="loginError" role="alert" hidden></p>
    </div>
    <button class="btn btn-primary btn-lg" type="submit">Sign in</button>
    <p class="a-note">Forgotten the password? The site administrator can reset it on the server with an admin-reset.txt file.</p>
  </form>
</main>

<!-- panel -->
<div class="a-shell" id="panel" hidden>
  <nav class="a-side" aria-label="Admin sections">
    {nav.map((g) => (
      <div class="a-side-group">
        <p>{g.label}</p>
        {g.items.map(([id, label]) => (
          <a class="a-nav-link" href={`#${id}`} data-nav={id}>
            <Fragment set:html={Svg(id)} />{label}
            {id === 'enquiries' && <span class="a-count" id="newCount" hidden></span>}
          </a>
        ))}
      </div>
    ))}
  </nav>

  <main id="adminMain" tabindex="-1">

    <!-- OVERVIEW: is everything fine, and what needs doing -->
    <section class="a-view" data-view="overview" aria-labelledby="h-overview" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-overview">Overview</h1>
          <p>How the website is doing for both businesses, compared with the period before, and what needs your attention.</p>
        </div>
        <label class="a-period"><span>Period</span>
          <select class="input" data-period>
            <option value="7">Last 7 days</option>
            <option value="30" selected>Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="365">Last 12 months</option>
          </select>
        </label>
      </div>
      <p class="a-freshness" data-freshness aria-live="polite"></p>

      <div class="a-card a-attention" aria-labelledby="h-attention">
        <h2 id="h-attention">Needs attention</h2>
        <ul class="a-alerts" id="ovAttention"><li class="v-skeleton"></li></ul>
      </div>

      <div class="a-kpis a-kpis-5" id="ovKpis" aria-label="Key numbers"></div>

      <div class="a-grid12">
        <div class="a-card span-8">
          <div class="a-card-head">
            <div><h2>Visitors and enquiries</h2><p>Daily visitors against the same number of days before. Dots below the axis are days with enquiries.</p></div>
          </div>
          <div id="ovTrend" class="v-block"></div>
        </div>
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>At a glance</h2><p>The strongest signal in each area for this period.</p></div></div>
          <dl class="a-facts" id="ovFacts"></dl>
        </div>
      </div>

      <div class="a-grid12">
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Agriculture journey</h2><p>Visitors who reached each step on the same day. Steps can be skipped, so read it as reach, not a strict path.</p></div></div>
          <div id="ovFunnelAgri"></div>
        </div>
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Packaging journey</h2><p>Visitors who reached each step on the same day.</p></div></div>
          <div id="ovFunnelPack"></div>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-head"><div><h2>Website setup</h2><p>What the site needs to turn visits into enquiries.</p></div></div>
        <ul class="a-checklist" id="ovHealth"></ul>
      </div>
    </section>

    <!-- TRAFFIC: where visitors come from, what they read, when -->
    <section class="a-view" data-view="traffic" aria-labelledby="h-traffic" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-traffic">Traffic</h1>
          <p>Where visitors come from, which pages hold their attention, when they visit and what they do. No cookies are used and no IP addresses are stored.</p>
        </div>
        <label class="a-period"><span>Period</span>
          <select class="input" data-period>
            <option value="7">Last 7 days</option>
            <option value="30" selected>Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="365">Last 12 months</option>
          </select>
        </label>
      </div>
      <p class="a-freshness" data-freshness aria-live="polite"></p>
      <div class="a-kpis a-kpis-5" id="trKpis" aria-label="Traffic numbers"></div>

      <div class="a-grid12">
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Where visitors come from</h2><p>Share of page views by source, with the change on the previous period.</p></div></div>
          <div id="trChannels"></div>
        </div>
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Referring websites</h2><p>Sites that linked to you. WhatsApp and most apps hide the link, so those visits count as direct.</p></div></div>
          <div id="trReferrers"></div>
        </div>
      </div>

      <div class="a-card">
        <div class="a-card-head"><div><h2>Pages</h2><p>Engaged means the page stayed open 15 seconds or was scrolled halfway. Time bands run from under 10 seconds (lightest) to over 3 minutes (darkest).</p></div></div>
        <div id="trPages"></div>
      </div>

      <div class="a-grid12">
        <div class="a-card span-8">
          <div class="a-card-head"><div><h2>When visitors arrive</h2><p>Page views by weekday and hour, Addis Ababa time.</p></div></div>
          <div id="trHeat"></div>
        </div>
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>Markets</h2><p>Browser language is a rough guide to where buyers are: Arabic suggests the Gulf, Chinese suggests China.</p></div></div>
          <div id="trMarkets"></div>
        </div>
      </div>

      <div class="a-grid12">
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Contact actions</h2><p>People reaching for a phone number, WhatsApp, email or the enquiry form.</p></div></div>
          <div id="trContact"></div>
        </div>
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Bag designer</h2><p>How visitors use the mockup studio on the packaging page.</p></div></div>
          <div id="trStudio"></div>
        </div>
      </div>

      <div class="a-grid12">
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Campaigns</h2><p>Visits from links tagged with utm_source, utm_medium and utm_campaign.</p></div></div>
          <div id="trCampaigns"></div>
        </div>
        <div class="a-card span-6">
          <div class="a-card-head"><div><h2>Devices and first pages</h2><p>What visitors use, and the page they landed on first.</p></div></div>
          <div id="trDevices"></div>
          <div id="trEntries" style="margin-top:18px"></div>
        </div>
      </div>
    </section>

    <!-- ENQUIRIES -->
    <section class="a-view" data-view="enquiries" aria-labelledby="h-enquiries" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-enquiries">Enquiries</h1>
          <p>Every message sent from the website, kept here even when the notification email fails. Move each one through the pipeline as you work it.</p>
        </div>
        <div class="row" style="--gap:8px">
          <label class="a-period"><span>Period</span>
            <select class="input" data-period>
              <option value="7">Last 7 days</option>
              <option value="30" selected>Last 30 days</option>
              <option value="90">Last 90 days</option>
              <option value="365">Last 12 months</option>
            </select>
          </label>
          <button class="btn btn-secondary" type="button" id="leadsCsv">Download CSV</button>
          <button class="btn btn-secondary" type="button" id="leadsRefresh">Refresh</button>
        </div>
      </div>

      <div class="a-kpis a-kpis-5" id="enKpis" aria-label="Enquiry numbers"></div>
      <div class="a-grid12">
        <div class="a-card span-8">
          <div class="a-card-head"><div><h2>Enquiries over time</h2><p>By business line. Packaging is hatched.</p></div></div>
          <div id="enVolume"></div>
        </div>
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>Pipeline</h2><p>Where this period's enquiries are now.</p></div></div>
          <div id="enPipeline"></div>
        </div>
      </div>
      <div class="a-grid12">
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>Response speed</h2><p>Time from arrival to the first move out of New.</p></div></div>
          <div id="enSpeed"></div>
        </div>
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>Lead quality</h2><p>Scored on the details a buyer gave. Open an enquiry to see why.</p></div></div>
          <div id="enQuality"></div>
        </div>
        <div class="a-card span-4">
          <div class="a-card-head"><div><h2>Markets and products</h2><p>From phone codes and email domains, and what was asked for.</p></div></div>
          <div id="enMarkets"></div>
        </div>
      </div>

      <div class="a-card a-inbox-head">
        <h2>Inbox</h2>
        <div class="a-filters">
          <label class="sr-only" for="leadStage">Stage</label>
          <select class="input" id="leadStage">
            <option value="open">Open (not won, lost or archived)</option>
            <option value="new">New</option>
            <option value="read">Opened</option>
            <option value="contacted">Contacted</option>
            <option value="quoted">Quoted</option>
            <option value="won">Won</option>
            <option value="lost">Lost</option>
            <option value="archived">Archived</option>
            <option value="all">All stages</option>
          </select>
          <label class="sr-only" for="leadLine">Business line</label>
          <select class="input" id="leadLine">
            <option value="all">Both business lines</option>
            <option value="agri">Agriculture</option>
            <option value="pack">Packaging</option>
          </select>
          <label class="sr-only" for="leadSort">Sort</label>
          <select class="input" id="leadSort">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="score">Strongest leads first</option>
          </select>
          <label class="a-check"><input type="checkbox" id="leadPeriodOnly"> Only this period</label>
          <label class="sr-only" for="leadSearch">Search enquiries</label>
          <input class="input grow" id="leadSearch" type="search" placeholder="Search name, company, email, port or message">
        </div>
        <p class="a-note" id="leadsSummary" role="status" aria-live="polite"></p>
      </div>
      <div class="a-leads" id="leads"></div>
    </section>

    <!-- PRODUCTS -->
    <section class="a-view" data-view="products" aria-labelledby="h-products" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-products">Products</h1>
          <p>The agricultural products in the stack on the agriculture page, in this order. The first product is the card in front.</p>
        </div>
        <div class="row" style="--gap:8px">
          <label class="a-period"><span>Period</span>
            <select class="input" data-period>
              <option value="7">Last 7 days</option>
              <option value="30" selected>Last 30 days</option>
              <option value="90">Last 90 days</option>
              <option value="365">Last 12 months</option>
            </select>
          </label>
          <button class="btn btn-primary" type="button" id="productNew">Add product</button>
        </div>
      </div>
      <div class="a-card">
        <div class="a-card-head"><div><h2>Performance</h2><p>Details opened on the agriculture page, enquiries that named the product, and how complete each product's content is. Sorted by interest.</p></div></div>
        <div id="prPerformance"></div>
      </div>
      <div class="a-products">
        <div class="a-card">
          <h2>Order on the website</h2>
          <p>Home page links open the first product whose category is Sesame, Pulses, Spices or Coffee, so keep those category names.</p>
          <ol class="a-plist" id="productList"></ol>
          <p class="sr-only" id="productLive" role="status" aria-live="polite"></p>
        </div>
        <div class="a-card a-editor">
          <h2 id="editorTitle">Add product</h2>
          <form class="a-form" id="productForm" novalidate>
            <input type="hidden" name="id">
            <div class="a-field">
              <label for="pName">Name</label>
              <input class="input" id="pName" name="name" required maxlength="200" aria-describedby="pNameErr">
              <p class="err" id="pNameErr" hidden></p>
            </div>
            <div class="a-two">
              <div class="a-field">
                <label for="pCategory">Category</label>
                <input class="input" id="pCategory" name="category" maxlength="50" list="categoryList">
                <datalist id="categoryList"><option value="Sesame"></option><option value="Pulses"></option><option value="Spices"></option><option value="Coffee"></option><option value="Specialty"></option></datalist>
              </div>
              <div class="a-field">
                <label for="pPurity">Purity</label>
                <input class="input" id="pPurity" name="purity" maxlength="50" placeholder="99.95%">
              </div>
            </div>
            <div class="a-field">
              <label for="pMoq">Minimum order</label>
              <input class="input" id="pMoq" name="moq" maxlength="50" placeholder="10 MT">
            </div>
            <div class="a-field">
              <label for="pDesc">Description</label>
              <textarea class="input" id="pDesc" name="description" required maxlength="2000" aria-describedby="pDescErr"></textarea>
              <p class="err" id="pDescErr" hidden></p>
            </div>
            <div class="a-field">
              <label for="pSpecs">Key points</label>
              <textarea class="input" id="pSpecs" name="specs" aria-describedby="pSpecsHint" style="min-height:96px"></textarea>
              <p class="hint" id="pSpecsHint">One per line, up to 20. Shown as a list in the product details.</p>
            </div>
            <div class="a-field">
              <span class="a-label" id="pImageLabel">Photo</span>
              <div class="a-image-row">
                <figure class="a-preview" id="pPreview" aria-hidden="true">
                  <img alt="" hidden>
                  <span class="ph">No photo</span>
                  <figcaption><em style="font-style:normal" data-preview-name>Product name</em><span data-preview-cat>Category</span></figcaption>
                </figure>
                <div>
                  <label class="a-drop" id="pDrop">
                    <input type="file" id="pImage" accept="image/jpeg,image/png,image/webp" aria-labelledby="pImageLabel" aria-describedby="pImageHint">
                    <strong>Upload a photo</strong>
                    <span id="pImageHint">JPG, PNG or WebP up to 10 MB. Saved at 1200 px. The card shows the centre in portrait.</span>
                  </label>
                  <button class="btn btn-ghost btn-sm" type="button" id="pImageClear" hidden>Remove photo</button>
                  <input type="hidden" name="image">
                </div>
              </div>
            </div>
            <div class="a-actions">
              <button class="btn btn-primary btn-lg" type="submit" id="productSave">Save product</button>
              <button class="btn btn-ghost btn-lg" type="button" id="productCancel" hidden>Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- COMPANY -->
    <section class="a-view" data-view="company" aria-labelledby="h-company" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-company">Company details</h1>
          <p>Phone numbers, email and addresses shown on every page of the website and used by the enquiry forms.</p>
        </div>
      </div>
      <form class="a-form" id="companyForm" novalidate>
        <div class="a-card a-form">
          <h2>Phone and email</h2>
          <div class="a-two">
            <div class="a-field">
              <label for="cPhones">Phone numbers</label>
              <textarea class="input" id="cPhones" name="phones" aria-describedby="cPhonesHint" style="min-height:96px"></textarea>
              <p class="hint" id="cPhonesHint">One per line. The first is the main sales number, also used for WhatsApp unless a WhatsApp link is set in Social links. The second is shown as the office line.</p>
            </div>
            <div class="a-field">
              <label for="cEmails">Email addresses</label>
              <textarea class="input" id="cEmails" name="emails" aria-describedby="cEmailsHint" style="min-height:96px"></textarea>
              <p class="hint" id="cEmailsHint">One per line. The first is shown on the website.</p>
            </div>
          </div>
        </div>
        <div class="a-card a-form">
          <h2>Head office address</h2>
          <div class="a-two">
            <div class="a-field"><label for="aLine2">Building and room</label><input class="input" id="aLine2" name="address.line2" placeholder="Soreti Building, 2nd Floor, Room 214"></div>
            <div class="a-field"><label for="aLine1">Area</label><input class="input" id="aLine1" name="address.line1" placeholder="Lemi Kura Subcity, Woreda 08"></div>
            <div class="a-field"><label for="aPo">P.O. Box</label><input class="input" id="aPo" name="address.poBox" placeholder="P.O. Box 46325"></div>
            <div class="a-field"><label for="aCity">City</label><input class="input" id="aCity" name="address.city" placeholder="Addis Ababa"></div>
            <div class="a-field"><label for="aCountry">Country</label><input class="input" id="aCountry" name="address.country" placeholder="Ethiopia"></div>
          </div>
          <div class="a-two">
            <div class="a-field"><label for="oName">Short office name</label><input class="input" id="oName" name="office.name" placeholder="Soreti Building"></div>
            <div class="a-field"><label for="oCity">Short office area</label><input class="input" id="oCity" name="office.city" placeholder="Lemi Kura, Addis Ababa"></div>
          </div>
          <p class="a-note">The short name and area appear together in the home page footer.</p>
        </div>
        <div class="a-card a-form">
          <h2>Processing facility</h2>
          <div class="a-two">
            <div class="a-field"><label for="fName">Name</label><input class="input" id="fName" name="factory.name" placeholder="Burayu"></div>
            <div class="a-field"><label for="fCity">Location</label><input class="input" id="fCity" name="factory.city" placeholder="15 km West of Addis Ababa"></div>
            <div class="a-field"><label for="fLat">Latitude</label><input class="input" id="fLat" name="factory.lat" inputmode="decimal" placeholder="9.0366"></div>
            <div class="a-field"><label for="fLng">Longitude</label><input class="input" id="fLng" name="factory.lng" inputmode="decimal" placeholder="38.6364"></div>
          </div>
          <p class="a-note">The coordinates are printed on the home page. New coordinates appear after the next deploy; phone, email and addresses update straight away.</p>
        </div>
        <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Save company details</button></div>
      </form>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="a-view" data-view="certifications" aria-labelledby="h-certs" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-certs">Certifications</h1>
          <p>Listed under the key facts on the agriculture page.</p>
        </div>
      </div>
      <div class="a-two" style="align-items:start">
        <div class="a-card">
          <h2>Current certifications</h2>
          <ul class="a-rows" id="certList"></ul>
        </div>
        <div class="a-card">
          <h2>Add a certification</h2>
          <form class="a-form" id="certForm" novalidate>
            <div class="a-field"><label for="certName">Name</label><input class="input" id="certName" name="name" required maxlength="200" placeholder="ISO 22000:2018"></div>
            <div class="a-field"><label for="certDesc">Description</label><input class="input" id="certDesc" name="description" required maxlength="500" placeholder="Food Safety Management System"></div>
            <div class="a-field">
              <label for="certImage">Badge image (optional)</label>
              <input class="input" id="certImage" type="file" accept="image/jpeg,image/png,image/webp" style="padding-top:9px">
            </div>
            <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Add certification</button></div>
          </form>
        </div>
      </div>
    </section>

    <!-- LOGO -->
    <section class="a-view" data-view="logo" aria-labelledby="h-logo" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-logo">Logo</h1>
          <p>Shown in the header and footer of every page. Transparent PNG works best.</p>
        </div>
      </div>
      <div class="a-two" style="align-items:start">
        <div class="a-card">
          <h2>Current logo</h2>
          <div class="a-logo-box" style="margin-top:16px"><img id="logoCurrent" src="/logo.png" alt="Current logo"></div>
          <p class="a-note" id="logoSource" style="margin-top:10px"></p>
          <div class="a-actions"><button class="btn btn-danger-quiet" type="button" id="logoReset" hidden>Use the original logo</button></div>
        </div>
        <div class="a-card">
          <h2>Upload a new logo</h2>
          <form class="a-form" id="logoForm" novalidate>
            <label class="a-drop" id="logoDrop">
              <input type="file" id="logoFile" accept="image/png,image/jpeg,image/webp,image/svg+xml" aria-describedby="logoHint">
              <strong id="logoDropTitle">Choose or drop a file</strong>
              <span id="logoHint">PNG, JPG, WebP or SVG. Saved as WebP, up to 600 px wide.</span>
            </label>
            <div class="a-logo-box" id="logoPreviewBox" hidden><img id="logoPreview" alt="New logo preview"></div>
            <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Save logo</button></div>
          </form>
        </div>
      </div>
    </section>

    <!-- SOCIAL -->
    <section class="a-view" data-view="social" aria-labelledby="h-social" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-social">Social links</h1>
          <p>Paste the full address of each profile. Blank ones are hidden on the website.</p>
        </div>
      </div>
      <form class="a-card a-form" id="socialForm" novalidate style="max-width:720px">
        <div class="a-two">
          <div class="a-field"><label for="sFacebook">Facebook</label><input class="input" id="sFacebook" name="facebook" type="url" placeholder="https://facebook.com/..."></div>
          <div class="a-field"><label for="sLinkedin">LinkedIn</label><input class="input" id="sLinkedin" name="linkedin" type="url" placeholder="https://linkedin.com/company/..."></div>
          <div class="a-field"><label for="sX">X</label><input class="input" id="sX" name="x" type="url" placeholder="https://x.com/..."></div>
          <div class="a-field"><label for="sYoutube">YouTube</label><input class="input" id="sYoutube" name="youtube" type="url" placeholder="https://youtube.com/@..."></div>
          <div class="a-field"><label for="sTelegram">Telegram</label><input class="input" id="sTelegram" name="telegram" type="url" placeholder="https://t.me/yourname" aria-describedby="sTgHint"><p class="hint" id="sTgHint">Shown next to WhatsApp in the contact details on every page. Leave blank to hide it.</p></div>
          <div class="a-field">
            <label for="sWhatsapp">WhatsApp</label>
            <input class="input" id="sWhatsapp" name="whatsapp" type="url" placeholder="https://wa.me/2519XXXXXXXX" aria-describedby="sWaHint">
            <p class="hint" id="sWaHint">Used by every WhatsApp button. Leave blank to use the main phone number.</p>
          </div>
        </div>
        <p class="err" id="socialErr" role="alert" hidden></p>
        <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Save social links</button></div>
      </form>
    </section>

    <!-- EMAIL -->
    <section class="a-view" data-view="email" aria-labelledby="h-email" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-email">Email delivery</h1>
          <p>The mail account that sends enquiry notifications to your team and a confirmation to the visitor.</p>
        </div>
        <span class="a-status" id="emailState">Checking</span>
      </div>
      <form class="a-card a-form" id="emailForm" novalidate style="max-width:720px">
        <div class="a-two">
          <div class="a-field"><label for="eHost">SMTP server</label><input class="input" id="eHost" name="smtpHost" required placeholder="smtp.gmail.com" autocomplete="off"></div>
          <div class="a-field"><label for="ePort">Port</label><input class="input" id="ePort" name="smtpPort" required inputmode="numeric" placeholder="587" aria-describedby="ePortHint"><p class="hint" id="ePortHint">587 for TLS, 465 for SSL.</p></div>
          <div class="a-field"><label for="eUser">Sending account</label><input class="input" id="eUser" name="smtpUser" type="email" required autocomplete="off" placeholder="notifications@gmail.com"></div>
          <div class="a-field"><label for="ePass">Password or app password</label><input class="input" id="ePass" name="smtpPassword" type="password" autocomplete="new-password" aria-describedby="ePassHint"><p class="hint" id="ePassHint">Leave blank to keep the saved password. For Gmail, create an app password at myaccount.google.com/apppasswords.</p></div>
          <div class="a-field"><label for="eTo">Send enquiries to</label><input class="input" id="eTo" name="recipientEmail" type="email" required placeholder="info@oliraagroindustry.com"></div>
          <div class="a-field"><label for="eFrom">Sender name</label><input class="input" id="eFrom" name="fromName" placeholder="Olira Agro Industry"></div>
        </div>
        <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Save email settings</button></div>
      </form>
    </section>

    <!-- MARKETING -->
    <section class="a-view" data-view="marketing" aria-labelledby="h-marketing" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-marketing">Marketing tags</h1>
          <p>Optional Google tools. Nothing from Google loads on the website until an ID is saved here.</p>
        </div>
      </div>
      <div class="a-two" style="align-items:start">
        <form class="a-card a-form" id="gaForm" novalidate>
          <h2>Google Analytics 4</h2>
          <span class="a-status" id="gaState">Not set</span>
          <div class="a-field"><label for="gaId">Measurement ID</label><input class="input" id="gaId" name="measurementId" placeholder="G-XXXXXXXXXX" pattern="G-[A-Z0-9]{10}" aria-describedby="gaHint"><p class="hint" id="gaHint">Google Analytics, Admin, Data streams, your web stream. Leave blank to turn it off.</p></div>
          <div class="a-field"><label for="gaProp">Property ID (optional)</label><input class="input" id="gaProp" name="propertyId" inputmode="numeric"></div>
          <div class="a-actions"><button class="btn btn-primary" type="submit">Save analytics</button></div>
        </form>
        <form class="a-card a-form" id="adsForm" novalidate>
          <h2>Google Ads conversions</h2>
          <span class="a-status" id="adsState">Not set</span>
          <div class="a-field"><label for="adsId">Conversion ID</label><input class="input" id="adsId" name="conversionId" inputmode="numeric" placeholder="10 digits" pattern="[0-9]{10}"></div>
          <div class="a-field"><label for="adsLabel">Conversion label</label><input class="input" id="adsLabel" name="conversionLabel"></div>
          <div class="a-field"><label for="adsValue">Value per enquiry (USD)</label><input class="input" id="adsValue" name="conversionValue" inputmode="decimal" placeholder="10"></div>
          <div class="a-actions"><button class="btn btn-primary" type="submit">Save conversions</button></div>
        </form>
      </div>
    </section>

    <!-- SECURITY -->
    <section class="a-view" data-view="security" aria-labelledby="h-security" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-security">Password</h1>
          <p>Change the admin password. It works straight away; you stay signed in on this device.</p>
        </div>
      </div>
      <form class="a-card a-form" id="passForm" novalidate style="max-width:520px">
        <div class="a-field"><label for="newPass">New password</label><input class="input" id="newPass" type="password" autocomplete="new-password" minlength="12" required aria-describedby="newPassHint"><p class="hint" id="newPassHint">At least 12 characters. A short sentence is easy to remember and hard to guess.</p></div>
        <div class="a-field"><label for="newPass2">Type it again</label><input class="input" id="newPass2" type="password" autocomplete="new-password" required aria-describedby="passErr"><p class="err" id="passErr" role="alert" hidden></p></div>
        <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Change password</button></div>
      </form>
    </section>
  </main>
</div>

<div class="a-toasts" id="toasts" role="status" aria-live="polite"></div>
<dialog class="a-dialog" id="confirmDialog" aria-labelledby="confirmTitle">
  <form method="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmBody"></p>
    <div class="a-actions">
      <button class="btn btn-secondary" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="ok" id="confirmOk">Delete</button>
    </div>
  </form>
</dialog>

<script>import '../scripts/admin/main.js';</script>
</body>
</html>
