    // Horizontal bar list used for pages / referrers / devices.
    // Labels come from visitor-supplied data (paths, referrer hosts) so they are
    // rendered with textContent — never innerHTML.
    function renderBarList(el, items, emptyLabel) {
      if (!el) return;
      el.replaceChildren();
      if (!items || !items.length) {
        const p = document.createElement('p');
        p.className = 'text-primary-400 text-sm';
        p.textContent = emptyLabel;
        el.appendChild(p);
        return;
      }
      const max = Math.max(...items.map((i) => i.count), 1);
      items.forEach((item) => {
        const row = document.createElement('div');

        const head = document.createElement('div');
        head.className = 'flex justify-between gap-3 mb-1';
        const name = document.createElement('span');
        name.className = 'truncate';
        name.title = item.name;
        name.textContent = item.name;
        const count = document.createElement('span');
        count.className = 'font-bold text-primary-900 flex-shrink-0';
        count.textContent = item.count;
        head.appendChild(name); head.appendChild(count);

        const track = document.createElement('div');
        track.className = 'h-1.5 bg-primary-100';
        const fill = document.createElement('div');
        fill.className = 'h-full bg-primary-600';
        fill.style.width = Math.round((item.count / max) * 100) + '%';
        track.appendChild(fill);

        row.appendChild(head); row.appendChild(track);
        el.appendChild(row);
      });
    }

    // Product interest: one row per product showing quote clicks alongside the
    // inquiries that actually named it, so the gap between the two is visible
    // (lots of clicks but no inquiries = people look, then don't ask).
    // Product names are admin-supplied, so use textContent, never innerHTML.
    function renderProductList(el, items) {
      if (!el) return;
      el.replaceChildren();
      if (!items || !items.length) {
        const p = document.createElement('p');
        p.className = 'text-primary-400 text-sm';
        p.textContent = 'No product interest recorded yet. Clicks on a "Request quote" button will appear here.';
        el.appendChild(p);
        return;
      }
      // Scale both bars against the same max so their lengths are comparable.
      const max = Math.max(...items.map((i) => Math.max(i.clicks, i.inquiries)), 1);
      items.forEach((item) => {
        const row = document.createElement('div');

        const head = document.createElement('div');
        head.className = 'flex justify-between gap-3 mb-1';
        const name = document.createElement('span');
        name.className = 'truncate font-medium';
        name.title = item.name;
        name.textContent = item.name;
        const count = document.createElement('span');
        count.className = 'flex-shrink-0 text-xs text-primary-600';
        count.textContent = `${item.clicks} click${item.clicks === 1 ? '' : 's'} · ${item.inquiries} inquir${item.inquiries === 1 ? 'y' : 'ies'}`;
        head.appendChild(name); head.appendChild(count);
        row.appendChild(head);

        [['bg-primary-600', item.clicks], ['bg-teal-accent', item.inquiries]].forEach(([color, value]) => {
          const track = document.createElement('div');
          track.className = 'h-1.5 bg-primary-100 mb-0.5';
          const fill = document.createElement('div');
          fill.className = `h-full ${color}`;
          fill.style.width = Math.round((value / max) * 100) + '%';
          track.appendChild(fill);
          row.appendChild(track);
        });

        el.appendChild(row);
      });
    }

    // Grouped bar chart (views + unique visitors per day). All values here are
    // server-generated numbers / ISO dates, so an SVG string is safe.
    function renderChart(series) {
      const host = document.getElementById('analyticsChart');
      if (!host) return;
      const H = 180, PAD_B = 26, GROUP = 14, BAR = 5;
      const max = Math.max(1, ...series.map((d) => Math.max(d.views, d.uniques)));
      const W = Math.max(series.length * GROUP + 10, 320);

      const bars = series.map((d, i) => {
        const x = 5 + i * GROUP;
        const vh = Math.round(((H - PAD_B) * d.views) / max);
        const uh = Math.round(((H - PAD_B) * d.uniques) / max);
        const label = `${d.date}: ${d.views} views, ${d.uniques} visitors, ${d.inquiries} inquiries`;
        return `<g><title>${label}</title>` +
          `<rect x="${x}" y="${H - PAD_B - vh}" width="${BAR}" height="${vh}" fill="#39572f"/>` +
          `<rect x="${x + BAR + 1}" y="${H - PAD_B - uh}" width="${BAR}" height="${uh}" fill="#2c7a7b"/>` +
          `</g>`;
      }).join('');

      // Show first / middle / last date so the axis stays readable at 90 days.
      const tickIdx = [0, Math.floor(series.length / 2), series.length - 1];
      const ticks = tickIdx.map((i) => {
        const d = series[i];
        if (!d) return '';
        const x = 5 + i * GROUP;
        const anchor = i === 0 ? 'start' : i === series.length - 1 ? 'end' : 'middle';
        return `<text x="${x + BAR}" y="${H - 8}" font-size="10" fill="#547d46" text-anchor="${anchor}">${d.date.slice(5)}</text>`;
      }).join('');

      host.innerHTML =
        `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Daily views and visitors">` +
        `<line x1="0" y1="${H - PAD_B}" x2="${W}" y2="${H - PAD_B}" stroke="#c8dba3" stroke-width="1"/>` +
        bars + ticks + `</svg>`;
    }

    async function loadAnalytics() {
      const days = analyticsRange ? analyticsRange.value : 30;
      try {
        const res = await fetch(`/api/analytics?days=${days}`, { headers: getAuthHeader() });
        if (res.status === 401) { toast('Session expired — please log in again.', 'error'); return; }
        if (!res.ok) { toast('Could not load analytics.', 'error'); return; }
        const d = await res.json();

        document.getElementById('kpiViews').textContent = d.totals.views.toLocaleString();
        document.getElementById('kpiUniques').textContent = d.totals.uniques.toLocaleString();
        document.getElementById('kpiInquiries').textContent = d.totals.inquiries.toLocaleString();
        document.getElementById('kpiConversion').textContent = d.totals.conversionRate + '%';

        renderChart(d.series);
        renderBarList(document.getElementById('analyticsPages'), d.topPages, 'No page views yet');
        renderBarList(document.getElementById('analyticsReferrers'), d.topReferrers, 'No referrers yet');
        renderBarList(document.getElementById('analyticsDevices'), [
          { name: 'Desktop', count: d.devices.desktop },
          { name: 'Mobile', count: d.devices.mobile },
          { name: 'Tablet', count: d.devices.tablet }
        ].filter((x) => x.count > 0), 'No device data yet');
        renderProductList(document.getElementById('analyticsProducts'), d.products);

        analyticsEmpty?.classList.toggle('hidden', d.totals.views > 0);
      } catch (err) {
        toast('Network error loading analytics.', 'error');
      }
    }

