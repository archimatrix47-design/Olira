    async function loadProducts() {
      productsListContainer.textContent = '';
      const loading = document.createElement('p');
      loading.className = 'text-primary-600 text-sm';
      loading.textContent = 'Loading products...';
      productsListContainer.appendChild(loading);

      try {
        const res = await fetch('/api/products');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const products = await res.json();
        renderProducts(products);
      } catch (err) {
        console.error('Failed to load products:', err);
        productsListContainer.textContent = '';
        const errMsg = document.createElement('p');
        errMsg.className = 'text-red-600 text-sm';
        errMsg.textContent = 'Failed to load products. Is the API server running?';
        productsListContainer.appendChild(errMsg);
        productCountLabel.textContent = '0';
      }
    }

    function renderProducts(products) {
      productsListContainer.textContent = '';
      productCountLabel.textContent = products.length;

      if (products.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'text-primary-600 text-sm';
        empty.textContent = 'No products yet. Add your first one above.';
        productsListContainer.appendChild(empty);
        return;
      }

      products.forEach(p => {
        const card = document.createElement('div');
        card.className = 'bg-white border-2 border-primary-200 p-6 hover:border-primary-600 transition';

        const top = document.createElement('div');
        top.className = 'flex justify-between items-start gap-4 mb-4';

        const left = document.createElement('div');
        left.className = 'flex gap-4 items-start flex-1 min-w-0';

        if (p.image) {
          const img = document.createElement('img');
          img.src = p.image;
          img.alt = p.name;
          img.className = 'w-20 h-20 object-cover rounded border border-primary-200 flex-shrink-0';
          img.loading = 'lazy';
          left.appendChild(img);
        }

        const info = document.createElement('div');
        info.className = 'min-w-0';
        const h5 = document.createElement('h5');
        h5.className = 'font-bold text-lg text-primary-900 truncate';
        h5.textContent = p.name;
        info.appendChild(h5);
        const desc = document.createElement('p');
        desc.className = 'text-primary-900 text-sm mt-1 line-clamp-2';
        desc.textContent = p.description;
        info.appendChild(desc);
        left.appendChild(info);
        top.appendChild(left);

        const actions = document.createElement('div');
        actions.className = 'flex gap-2 flex-shrink-0';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'p-2 border-2 border-primary-600 text-primary-600 hover:bg-primary-50 transition';
        editBtn.title = 'Edit';
        editBtn.setAttribute('aria-label', `Edit ${p.name}`);
        editBtn.appendChild(makeIcon('edit', 18));
        editBtn.addEventListener('click', () => fillProductForm(p));
        actions.appendChild(editBtn);

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'p-2 border-2 border-red-600 text-red-600 hover:bg-red-50 transition';
        delBtn.title = 'Delete';
        delBtn.setAttribute('aria-label', `Delete ${p.name}`);
        delBtn.appendChild(makeIcon('delete', 18));
        delBtn.addEventListener('click', () => deleteProduct(p));
        actions.appendChild(delBtn);

        top.appendChild(actions);
        card.appendChild(top);

        const meta = document.createElement('div');
        meta.className = 'flex flex-wrap gap-x-6 gap-y-2 text-sm text-primary-600';
        if (p.purity)   { const s = document.createElement('span'); s.className = 'font-semibold'; s.textContent = `Purity: ${p.purity}`; meta.appendChild(s); }
        if (p.moq)      { const s = document.createElement('span'); s.className = 'font-semibold'; s.textContent = `MOQ: ${p.moq}`; meta.appendChild(s); }
        if (p.category) { const s = document.createElement('span'); s.className = 'font-semibold'; s.textContent = `Category: ${p.category}`; meta.appendChild(s); }
        card.appendChild(meta);

        productsListContainer.appendChild(card);
      });
    }

    async function deleteProduct(p) {
      if (!confirm(`Delete "${p.name}"? This cannot be undone.`)) return;
      try {
        const res = await fetch(`/api/products/${encodeURIComponent(p.id)}`, {
          method: 'DELETE',
          headers: { ...getAuthHeader() }
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          throw new Error(j.error || 'HTTP ' + res.status);
        }
        toast(`Deleted: ${p.name}`, 'success');
        loadProducts();
      } catch (err) {
        toast('Delete failed: ' + err.message, 'error');
      }
    }

    // Image file -> upload to /api/upload/product-image -> store returned path
    productImageFile.addEventListener('change', async () => {
      const file = productImageFile.files[0];
      if (!file) return;
      if (file.size > 10 * 1024 * 1024) {
        toast('Image too large (max 10MB)', 'error');
        productImageFile.value = '';
        return;
      }

      // Local preview while uploading
      const localUrl = URL.createObjectURL(file);
      productImagePreview.src = localUrl;
      productImagePreview.style.display = 'block';
      productImagePlaceholder.style.display = 'none';

      const fd = new FormData();
      fd.append('image', file);
      fd.append('productId', productNameField.value || 'product');

      try {
        productSaveBtn.disabled = true;
        toast('Uploading image...', 'info');
        const res = await fetch('/api/upload/product-image', {
          method: 'POST',
          headers: { ...getAuthHeader() },
          body: fd
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');
        setProductImagePreview(data.path);
        toast('Image uploaded & optimized', 'success');
      } catch (err) {
        toast('Upload failed: ' + err.message, 'error');
        setProductImagePreview('');
      } finally {
        productSaveBtn.disabled = false;
        productImageFile.value = '';
      }
    });

    productImageClearBtn.addEventListener('click', () => setProductImagePreview(''));
    productCancelEditBtn.addEventListener('click', resetProductForm);
    productsRefreshBtn.addEventListener('click', loadProducts);

    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const product = {
        id: productIdField.value || undefined,
        name: productNameField.value.trim(),
        description: productDescField.value.trim(),
        purity: productPurityField.value.trim(),
        moq: productMoqField.value.trim(),
        category: productCategoryField.value.trim() || 'General',
        specs: productSpecsField.value.split('\n').map(s => s.trim()).filter(Boolean),
        image: productImagePath.value || null
      };

      if (!product.name || !product.description) {
        toast('Name and description are required', 'error');
        return;
      }

      try {
        productSaveBtn.disabled = true;
        const res = await fetch('/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
          body: JSON.stringify({ product })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');
        toast(productIdField.value ? 'Product updated' : 'Product added', 'success');
        resetProductForm();
        loadProducts();
      } catch (err) {
        toast('Save failed: ' + err.message, 'error');
      } finally {
        productSaveBtn.disabled = false;
      }
    });

    // Load products on page-load and when Products tab is clicked
    loadProducts();
    if (tabButtons.products) {
      tabButtons.products.addEventListener('click', loadProducts);
    }
  </script>
</BaseLayout>
