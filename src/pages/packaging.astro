---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ContactLines from '../components/site/ContactLines.astro';
import InquiryForm from '../components/site/InquiryForm.astro';
import { contact, SITE, packagingProducts } from '../lib/site-data';

const studioBags = packagingProducts.filter((p) => p.image && p.quad);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Custom printed kraft paper bags',
  description: "Kraft paper bags with twisted or flat paper handles in small, medium and large sizes, printed with the buyer's logo and supplied flat-packed in bundles.",
  brand: { '@type': 'Brand', name: 'Olira Packaging' },
  manufacturer: { '@type': 'Organization', name: 'Olira Agro Industry', url: `${SITE}/`, email: contact.email },
  material: 'Kraft paper',
  url: `${SITE}/packaging/`,
  image: `${SITE}/images/packaging/packaging-hero-1080.webp`,
};
---
<SiteLayout
  title="Kraft paper bags, Olira Packaging"
  description="Kraft paper bags with twisted or flat handles, made to your size and printed with your logo. Design your bag in the mockup studio and request a quote."
  ogImage="/og-packaging.jpg"
  ogImageAlt="Kraft paper bags with twisted handles"
  bodyClass="theme-pack"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" href="/images/packaging/packaging-hero-1080.avif" type="image/avif" imagesrcset="/images/packaging/packaging-hero-720.avif 720w, /images/packaging/packaging-hero-1080.avif 1080w, /images/packaging/packaging-hero-1440.avif 1440w" imagesizes="(max-width: 960px) 100vw, 45vw" fetchpriority="high">

  <SiteNav links={[{ href: '#formats', label: 'Formats' }, { href: '#studio', label: 'Mockup studio' }, { href: '#quote', label: 'Quote' }, { href: '/agriculture/', label: 'Agriculture' }]} cta={{ href: '#quote', label: 'Request a quote' }} />

  <main id="main">
    <section class="container page-hero">
      <div class="hero-split">
        <div>
          <span class="line-label">Olira Packaging</span>
          <h1>Kraft paper bags with your brand on them</h1>
          <p class="lede">Twisted and flat handle paper bags for shops, cafés, bakeries and brands. Made to your size, printed with your logo and supplied flat-packed in bundles.</p>
          <div class="row" style="--gap:10px;margin-top:28px;flex-wrap:wrap">
            <a class="btn btn-lg btn-primary" href="#studio">Design your bag</a>
            <a class="btn btn-lg btn-secondary" href="#quote">Request a quote</a>
          </div>
        </div>
        <picture class="hero-photo">
          <source type="image/avif" srcset="/images/packaging/packaging-hero-720.avif 720w, /images/packaging/packaging-hero-1080.avif 1080w, /images/packaging/packaging-hero-1440.avif 1440w" sizes="(max-width: 960px) 100vw, 45vw">
          <img src="/images/packaging/packaging-hero-1080.webp" srcset="/images/packaging/packaging-hero-720.webp 720w, /images/packaging/packaging-hero-1080.webp 1080w, /images/packaging/packaging-hero-1440.webp 1440w" sizes="(max-width: 960px) 100vw, 45vw" alt="Brown kraft paper shopping bags with twisted paper handles" width="1080" height="1440" fetchpriority="high">
        </picture>
      </div>
    </section>

    <section class="container" id="formats" data-fade aria-labelledby="formatsTitle">
      <h2 class="sr-only" id="formatsTitle">Formats</h2>
      <div class={`formats cols-${Math.min(4, Math.max(2, packagingProducts.length + 1))}`} id="packagingFormats">
        {packagingProducts.map((p) => (
          <div class="format" data-product={p.id}>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            {p.moq && <p class="format-moq">Minimum order {p.moq}</p>}
            {p.specs.length > 0 && <ul class="format-specs">{p.specs.map((s) => <li>{s}</li>)}</ul>}
          </div>
        ))}
        <div class="format format-static"><h3>Flat-packed bundles</h3><p>Bags supplied folded and stacked in bundles, ready to store and use. Brown kraft as standard, white kraft on request.</p></div>
      </div>
    </section>

    <section class="sec container" id="studio" aria-labelledby="studioTitle">
      <div class="sec-head" data-fade>
        <h2 id="studioTitle">Mockup studio</h2>
        <p class="lede">Choose a bag, add your logo and text, and move the design into place. Download the mockup or send the design with your quote request.</p>
      </div>
  
      <div class="studio">
        <div class="sheet stage">
          <canvas class="stage-canvas" id="bagCanvas" width="1200" height={studioBags[0]?.width ? Math.round(1200 * (studioBags[0].height || 1) / studioBags[0].width) : 1680} tabindex="0" role="img" aria-label="Bag mockup preview with your design" aria-describedby="stageInfo stageHelp"></canvas>
          <script type="application/json" id="packagingData" set:html={JSON.stringify(packagingProducts).replace(/</g, '\\u003c')}></script>
          <div class="stage-meta">
            <span class="note" id="stageHelp">Drag the design on the bag, or focus the preview and use the arrow keys. Hold Shift to move further.</span>
            <span class="note" id="stageInfo">Medium {(studioBags[0]?.name || 'kraft bags').replace(/s$/, '').toLowerCase()}, 25 x 11 x 32 cm, teal ink</span>
          </div>
        </div>
  
        <div class="sheet panel">
          <p class="sr-only" id="studioStatus" role="status" aria-live="polite"></p>
  
          <fieldset class="choice">
            <legend class="field-label">Bag</legend>
            <div class="chips" id="templateChips">
              {studioBags.map((m, i) => (
                <label class="opt"><input type="radio" name="template" value={m.id} data-handle={m.handle} checked={i === 0}><span>{m.name}</span></label>
              ))}
            </div>
          </fieldset>
  
          <fieldset class="choice">
            <legend class="field-label">Size</legend>
            <div class="chips">
              <label class="opt"><input type="radio" name="size" value="small"><span>Small</span></label>
              <label class="opt"><input type="radio" name="size" value="medium" checked><span>Medium</span></label>
              <label class="opt"><input type="radio" name="size" value="large"><span>Large</span></label>
            </div>
          </fieldset>
  
          <div>
            <span class="field-label" id="logoLbl">Your logo</span>
            <label class="drop" id="drop">
              <input type="file" id="logoFile" accept="image/png,image/jpeg,image/svg+xml,image/webp" aria-labelledby="logoLbl dropTitle" aria-describedby="dropSub">
              <strong id="dropTitle">Upload a logo</strong>
              <span id="dropSub">PNG, JPG, SVG or WebP. Transparent PNG looks best.</span>
            </label>
            <div class="row" style="justify-content:space-between;margin-top:10px;--gap:10px;flex-wrap:wrap">
              <label class="check"><input type="checkbox" id="oneInk"> Print logo in the ink colour</label>
              <button class="btn btn-ghost btn-sm" type="button" id="removeLogo" hidden>Remove logo</button>
            </div>
          </div>
  
          <div class="two">
            <div><label class="field-label" for="text1">Main text</label><input class="text-field" id="text1" maxlength="18" value="YOUR BRAND" autocomplete="off"></div>
            <div><label class="field-label" for="text2">Second line</label><input class="text-field" id="text2" maxlength="28" value="yourbrand.com" autocomplete="off"></div>
          </div>
  
          <fieldset class="choice">
            <legend class="field-label">Ink colour</legend>
            <div class="chips">
              <label class="opt opt-swatch" title="Black"><input type="radio" name="ink" value="black"><span style="--sw:#1E1B16"></span><b class="sr-only">Black</b></label>
              <label class="opt opt-swatch" title="Teal"><input type="radio" name="ink" value="teal" checked><span style="--sw:#186078"></span><b class="sr-only">Teal</b></label>
              <label class="opt opt-swatch" title="Leaf green"><input type="radio" name="ink" value="leaf"><span style="--sw:#4A5E17"></span><b class="sr-only">Leaf green</b></label>
              <label class="opt opt-swatch" title="Red"><input type="radio" name="ink" value="red"><span style="--sw:#A3301E"></span><b class="sr-only">Red</b></label>
              <label class="opt opt-swatch" title="White"><input type="radio" name="ink" value="white"><span style="--sw:#FAF7F0"></span><b class="sr-only">White</b></label>
            </div>
          </fieldset>
  
          <div>
            <label class="field-label" for="scale">Design size</label>
            <input class="range" id="scale" type="range" min="50" max="140" value="100" aria-valuetext="100 percent">
            <div class="range-row" aria-hidden="true"><span>Smaller</span><span>Larger</span></div>
          </div>
  
          <fieldset class="choice">
            <legend class="field-label">Move the design</legend>
            <div class="nudge">
              <button class="round-btn" type="button" data-nudge="left" aria-label="Move left"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
              <button class="round-btn" type="button" data-nudge="up" aria-label="Move up"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg></button>
              <button class="round-btn" type="button" data-nudge="down" aria-label="Move down"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
              <button class="round-btn" type="button" data-nudge="right" aria-label="Move right"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
              <button class="btn btn-secondary" type="button" id="resetPos">Centre design</button>
            </div>
          </fieldset>
  
          <div class="panel-actions">
            <button class="btn btn-lg btn-secondary" type="button" id="download" aria-describedby="downloadHint">Download PNG</button>
            <a class="btn btn-lg btn-primary" href="#quote" id="useDesign">Quote this design</a>
          </div>
          <p class="note" id="downloadHint">Your logo stays in your browser unless you choose to send it with a quote request. Bag photos are for preview; production finish and print can vary.</p>
        </div>
      </div>
    </section>
    <section class="sec container" id="quote" style="padding-top:0" aria-labelledby="quoteTitle">
      <div class="contact" data-fade>
        <div>
          <h2 id="quoteTitle">Request a quote</h2>
          <p class="lede" style="margin-top:20px">Send the format, size and quantity, with your artwork and the design from the studio if you have them. We usually reply within 24 hours.</p>
          <ContactLines />
        </div>
        <InquiryForm prefix="p" line="Packaging" labelledBy="quoteTitle" extra="qty" messagePlaceholder="Bag size, handle, print colours and delivery" messageRequired="Tell us the bag and print you need." submitLabel="Send request" noun="request" team="packaging team" attachments />
      </div>
    </section>

    <section class="container" style="padding-bottom: 56px">
      <div class="sheet switch-line">
        <p>Buying sesame, pulses, spices or coffee? Olira Agro is our separate agricultural export line.</p>
        <a class="btn btn-secondary" href="/agriculture/">Go to agriculture</a>
      </div>
    </section>
  </main>

  <SiteFooter note="Olira Packaging, a product line of Olira Agro Industry, Addis Ababa." />

  <script>import '../scripts/pack.js';</script>
</SiteLayout>
