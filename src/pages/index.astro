---
// Home: both businesses side by side, each showing its own products, and the
// visitor chooses. Nothing else competes with that choice; the footer carries the
// ways to ask and every other link.
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { contact, SITE, packagingProducts, partners, socialLinks } from '../lib/site-data';
import { graph, organizationGraph, ORG_ID, SITE_ID } from '../lib/seo';
import { cutoutOf, standHTML } from '../scripts/catalogue-panel.js';
import { thumbSrcset } from '../../lib/thumb-url.js';

// A product that still carries its standard photo, as a cut-out at a relative height.
const stood = (id: string, h: number) => {
  const p = packagingProducts.find((x) => x.id === id);
  const c = p && cutoutOf(p);
  return c ? { p, c, h } : null;
};
type Stood = { p: any; c: any; h: number; w: number };
// Each product's share of its row (--w, percent), from its true height and its
// cut-out's proportions, so a row of products always fits and stays in scale.
const pick = (list: [string, number][], fill = 100, gap = 1.6) => {
  const got = list.map(([id, h]) => stood(id, h)).filter(Boolean) as Stood[];
  const units = got.map((x) => x.h * x.c.width / x.c.height);
  const total = units.reduce((a, b) => a + b, 0) || 1;
  const room = fill - gap * (got.length - 1);
  return got.map((x, i) => ({ ...x, w: +(units[i] / total * room).toFixed(2) }));
};

// the agriculture door's product lines, each opening that product in the range
const PRODUCE = [
  { p: 'sesame', name: 'Humera sesame', img: '/products/photos/sesame-natural.webp' },
  { p: 'pulses', name: 'Pulses', img: '/products/photos/pulses.webp' },
  { p: 'spices', name: 'Spices', img: '/products/photos/spices.webp' },
  { p: 'coffee', name: 'Coffee', img: '/products/photos/coffee.webp' },
];
// two tiles a row inside each half: about 45% of a phone, a quarter of a wide screen
const TILE_SIZES = '(max-width: 860px) 45vw, 24vw';

// the packaging door's lineup, tallest to smallest, heights true to each other
const lineup = pick([['pk_twisted', 100], ['pk_foil', 86], ['pk_pouch', 74], ['pk_burger', 50]], 100, 4);

// who we are, as search engines and AI assistants read it (src/lib/seo.ts)
const jsonLd = graph(organizationGraph(socialLinks.map((l) => l.url)), {
  '@type': 'WebPage', '@id': `${SITE}/#webpage`, url: `${SITE}/`, name: 'Olira Agro Industry, agricultural exports and printed packaging',
  isPartOf: { '@id': SITE_ID }, about: { '@id': ORG_ID }, inLanguage: 'en',
});
---
<SiteLayout
  title="Olira Agro Industry, agricultural exports and printed packaging"
  description="Humera sesame, pulses, spices and coffee from Ethiopia, and paper bags, food boxes, medical packets and foil bags printed with your logo. Since 2008."
  ogImage="/og-home.jpg"
  ogImageAlt="Olira Agro Industry: agricultural exports and printed packaging"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" href={PRODUCE[0].img} imagesrcset={thumbSrcset(PRODUCE[0].img) || undefined} imagesizes={thumbSrcset(PRODUCE[0].img) ? TILE_SIZES : undefined} fetchpriority="high">

  <SiteHeader groups={[[{ href: '/packaging/', label: 'Packaging' }, { href: '/packaging/#studio', label: 'Mockup studio' }, { href: '/agriculture/', label: 'Agriculture' }, { href: '/packaging/#quote', label: 'Contact' }]]} current="/" />

  <main id="main">
    <!-- the first view: both businesses, side by side; the visitor chooses -->
    <section class="choose" aria-label="Our two businesses">
      <h1 class="sr-only">Olira Agro Industry</h1>
      <div class="wrap choose-grid">
        <!-- both doors have the same shape: the words on top, the products below -->
        <article class="door door-agri" aria-labelledby="doorAgri">
          <div class="door-copy">
            <span class="label">Olira Agro</span>
            <h2 class="headline" id="doorAgri">Agricultural <span class="grad-leaf">exports.</span></h2>
            <p class="sub">Humera sesame, pulses, spices and coffee from the Ethiopian highlands.</p>
            <div class="acts">
              <a class="act fill" href="/agriculture/" aria-describedby="doorAgri">View the range</a>
              <a class="act" href="/agriculture/#contact">Talk to sales</a>
            </div>
          </div>
          <ul class="produce" aria-label="Product lines">
            {PRODUCE.map((x, i) => (
              <li>
                <a href={`/agriculture/?p=${x.p}#range`} class:list={['produce-tile', { 'is-lead': i === 0 }]}>
                  <img src={x.img} srcset={thumbSrcset(x.img) || undefined} sizes={TILE_SIZES} alt="" width="800" height="600" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'}>
                  <span>{x.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
        <article class="door door-pack" aria-labelledby="packTitle">
          <div class="door-copy">
            <span class="label">Olira Packaging</span>
            <h2 class="headline" id="packTitle">Printed <span class="grad">packaging.</span></h2>
            <p class="sub">Paper bags, boxes, packets and foil bags, made to your size and printed with your logo.</p>
            <div class="acts">
              <a class="act fill" href="/packaging/" aria-describedby="packTitle">See the catalogue</a>
              <a class="act" href="/packaging/#studio">Open the studio</a>
            </div>
          </div>
          <div class="lineup" data-lineup aria-hidden="true">
            {lineup.map(({ c, p, w, h }, i) => (
              <div class="item" style={`--w:${w}`} data-name={p.name} data-id={p.id} data-h={h}>
                <Fragment set:html={standHTML(c, p.name, { eager: i < 3, brand: 'olira' })} />
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <!-- the organisations Olira has worked with: logos only, moving slowly right to
         left; hidden until the marketing team has added some (home.js keeps it live) -->
    <section class="partners" aria-labelledby="partnersTitle" data-partners hidden={partners.length === 0}>
      <div class="wrap">
        <h2 class="partners-title" id="partnersTitle">Organisations we have worked with</h2>
      </div>
      <div class="marquee" data-marquee>
        <div class="marquee-track">
          <ul class="marquee-set" aria-label="Partner organisations">
            {partners.map((p) => (
              <li>{p.url
                ? <a href={p.url} target="_blank" rel="noopener"><img src={p.logo} alt={p.name} width={p.width || 160} height={p.height || 40} loading="lazy" decoding="async"></a>
                : <img src={p.logo} alt={p.name} width={p.width || 160} height={p.height || 40} loading="lazy" decoding="async">}</li>
            ))}
          </ul>
        </div>
      </div>
      <button class="marquee-toggle" type="button" aria-pressed="false" aria-label="Pause the moving logos">
        <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>
      </button>
    </section>
  </main>

  <SiteFooter note="Head office, Addis Ababa. Processing facility, Burayu, Oromia." />

  <script>import '../scripts/common.js'; import '../scripts/home.js'; import '../scripts/live-print.js'; import '../scripts/motion.js';</script>
</SiteLayout>
