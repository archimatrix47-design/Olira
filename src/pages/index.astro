---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Modal from '../components/Modal.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icons.astro';
import Timeline from '../components/Timeline.astro';
import CertificationShowcase from '../components/CertificationShowcase.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read products from data file at build/SSR time.
// Admin edits via /api/products write to this same file, so a rebuild
// (or SSR request) picks them up. For instant freshness without rebuild,
// the inline script below also re-fetches from /api/products on the client.
let products: any[] = [];
try {
  const productsPath = path.join(process.cwd(), 'data', 'products.json');
  if (fs.existsSync(productsPath)) {
    products = JSON.parse(fs.readFileSync(productsPath, 'utf8'));
  }
} catch (err) {
  console.error('Failed to read data/products.json:', err);
}

const features = [
  {
    icon: '/icons/quality.webp',
    title: 'Quality Guaranteed',
    description: 'ISO 22000 certified. Every batch tested for purity, moisture, and contaminants.'
  },
  {
    icon: '/icons/global.webp',
    title: 'Global Shipping',
    description: 'Export-ready products. USA, EU, Middle East certified. Reliable logistics partners.'
  },
  {
    icon: '/icons/trusted.webp',
    title: 'Trusted Partner',
    description: 'Since 2008. Consistent quality, on-time delivery, responsive support.'
  },
  {
    icon: '/icons/organic.webp',
    title: 'Organic Options',
    description: 'Both conventional and certified organic available for all product lines.'
  },
  {
    icon: '/icons/packaging.webp',
    title: 'Custom Packaging',
    description: 'Flexible packaging for bulk orders. 50 MT minimum for custom solutions.'
  },
  {
    icon: '/icons/fair_price.webp',
    title: 'Fair Pricing',
    description: 'Direct from producer. Flexible payment terms. Volume discounts available.'
  }
];

// Certifications are loaded client-side from /api/certifications
// (see BaseLayout's loadCertificationsFromStorage). No server-render needed.
---

<BaseLayout
  title="Olira Agro Industry - Premium Ethiopian Agricultural Exports"
  description="Premium sesame seeds, pulses, spices, and coffee from Ethiopia. ISO 22000 certified. Trusted by 50+ countries. Since 2008."
>
  <Hero />

  <!-- Products Section - Asymmetric Layout (Pattern A) -->
  <section id="products" class="bg-white py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-20 lg:mb-24 animate-slideUp">
        <span class="section-label">OUR COLLECTION</span>
        <h2 class="heading-with-rule font-heading text-5xl lg:text-6xl font-bold text-primary-900 mb-8 leading-[1.05]">Selected<br/>and&nbsp;exacting</h2>
        <p class="text-lg text-primary-900 max-w-3xl leading-relaxed">
          Carefully selected and processed agricultural products meeting international quality standards. Trusted by importers and distributors worldwide.
        </p>
      </div>

      <!-- Products Grid - All Equal Size -->
      <!-- Initial render comes from data/products.json (frontmatter) for fast
           first paint + SEO. The script at the bottom of this file re-fetches
           /api/products and re-renders ONLY if the admin changed the data since
           the last build — so admin edits go live without a rebuild. -->
      <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((product, i) => (
          <div class="scroll-trigger" data-trigger-animation="slideUp" style={{ animationDelay: `${i * 0.1}s` }}>
            <ProductCard {...product} cardIndex={i} />
          </div>
        ))}
      </div>

      <!-- Snapshot of the build-time products so the client can detect drift
           without a flash when nothing changed. `<` is escaped to keep the
           JSON script tag from being closed early by any product text. -->
      <script type="application/json" id="products-initial" is:inline set:html={JSON.stringify(products).replace(/</g, '\\u003c')}></script>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="w-full max-w-4xl animate-slideUp mb-24">
        <span class="section-label">OUR STORY</span>
        <h2 class="heading-with-rule font-heading text-5xl lg:text-6xl font-bold text-primary-900 mb-8 leading-[1.05]">Built on<br/>provenance</h2>
        <p class="text-xl text-primary-900 leading-relaxed max-w-3xl">
          Founded in 2008 by two Ethiopian professionals with over 50 years of combined expertise in agronomy and agricultural products processing, Olira Agro Industry has grown into a trusted partner for premium agricultural exports. Our commitment to quality and sustainability has made us a preferred supplier for importers in over 50 countries worldwide, while also supporting local Ethiopian markets.
