---
// Home: two halves, one per business, and contact details only.
import SiteLayout from '../layouts/SiteLayout.astro';
import ThemeButton from '../components/site/ThemeButton.astro';
import { contact, SITE } from '../lib/site-data';
import contoursUrl from '../data/burayu-contours.json?url';

const lat = contact.factory.lat, lng = contact.factory.lng;
const coord = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)} ${v >= 0 ? pos : neg}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Olira Agro Industry',
  url: `${SITE}/`,
  logo: `${SITE}/logo.png`,
  foundingDate: '2008',
  email: contact.email,
  telephone: contact.phoneHref.slice(4),
  address: { '@type': 'PostalAddress', streetAddress: 'Soreti Building, 2nd Floor, Room 214, Lemi Kura Subcity, Woreda 08', postOfficeBoxNumber: '46325', addressLocality: 'Addis Ababa', addressCountry: 'ET' },
  location: { '@type': 'Place', name: 'Olira processing facility', address: { '@type': 'PostalAddress', addressLocality: 'Burayu', addressRegion: 'Oromia', addressCountry: 'ET' }, geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng } },
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', telephone: contact.phoneHref.slice(4), email: contact.email },
  makesOffer: [
    { '@type': 'Offer', url: `${SITE}/agriculture/`, itemOffered: { '@type': 'Product', name: 'Agricultural exports', description: 'Humera sesame, pulses, spices and coffee from Ethiopia.' } },
    { '@type': 'Offer', url: `${SITE}/packaging/`, itemOffered: { '@type': 'Product', name: 'Kraft paper bags', description: 'Twisted and flat handle kraft paper bags, custom printed with your logo.' } },
  ],
};
---
<SiteLayout
  title="Olira Agro Industry, agricultural exports and kraft paper bags"
  description="Olira Agro Industry exports Humera sesame, pulses, spices and coffee from Ethiopia, and makes custom printed kraft paper bags. Addis Ababa, since 2008."
  ogImage="/og-home.jpg"
  ogImageAlt="Olira Agro Industry: agricultural exports and kraft paper bags"
  bodyClass="split-body"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/home/sesame-natural-800.avif" type="image/avif" fetchpriority="high">
    <link rel="expect" href="#main" blocking="render">
    <script is:inline>
      // Page transitions (styles in site.css). The half that leads to the other
      // page becomes the moving photo; the other half slides off its own side.
      // Names are set only for the transition in progress, so they never clash.
      (function () {
        function line(url) {
          if (!url) return null;
          var p = new URL(url, location.href).pathname;
          return /^\/agriculture/.test(p) ? 'agri' : /^\/packaging/.test(p) ? 'pack' : null;
        }
        function mark(to) {
          var agri = document.querySelector('.half-agri'), pack = document.querySelector('.half-pack');
          if (!agri || !pack) return;
          agri.style.viewTransitionName = to === 'agri' ? 'agri-photo' : to === 'pack' ? 'side-left' : '';
          pack.style.viewTransitionName = to === 'pack' ? 'pack-photo' : to === 'agri' ? 'side-right' : '';
        }
        addEventListener('pageswap', function (e) {
          if (e.viewTransition) mark(line(e.activation && e.activation.entry && e.activation.entry.url));
        });
        addEventListener('pagereveal', function (e) {
          mark(null);
          if (!e.viewTransition) return;
          var from = window.navigation && navigation.activation && navigation.activation.from;
          mark(line(from && from.url));
          e.viewTransition.finished.then(function () { mark(null); });
        });
      })();
    </script>
  </Fragment>

  <header class="split-top">
    <a class="brand" href="/"><img src="/logo.png" alt="Olira Agro Industry, home" width="80" height="38" data-brand-logo></a>
    <ThemeButton />
  </header>

  <main class="split" id="main">
    <h1 class="sr-only">Olira Agro Industry</h1>

    <article class="half half-agri" aria-labelledby="agri-title">
      <picture class="half-bg">
        <source type="image/avif" srcset="/images/home/sesame-natural-800.avif 800w" sizes="(max-width: 760px) 100vw, 50vw">
        <img src="/images/home/sesame-natural-800.webp" srcset="/images/home/sesame-natural-800.webp 800w" sizes="(max-width: 760px) 100vw, 50vw" alt="" width="800" height="600" fetchpriority="high">
      </picture>
      <p class="coords"><b>Burayu, Oromia</b>{coord(lat, 'N', 'S')}, {coord(lng, 'E', 'W')}<br>2,600 m above sea level</p>
      <div class="half-inner">
        <span class="half-label">Olira Agro</span>
        <h2 id="agri-title">Agricultural exports</h2>
        <p>Grown in the Ethiopian highlands, cleaned and tested in Burayu, shipped to importers in more than 50 countries.</p>
        <ul class="pills" aria-label="Product lines">
          <li><a href="/agriculture/?p=sesame#range">Humera sesame</a></li>
          <li><a href="/agriculture/?p=pulses#range">Pulses</a></li>
          <li><a href="/agriculture/?p=spices#range">Spices</a></li>
          <li><a href="/agriculture/?p=coffee#range">Coffee</a></li>
        </ul>
        <a class="half-cta" href="/agriculture/" aria-describedby="agri-title">View the range</a>
      </div>
    </article>

    <article class="half half-pack" aria-labelledby="pack-title">
      <picture class="half-bg">
        <source type="image/avif" srcset="/images/packaging/packaging-hero-720.avif 720w, /images/packaging/packaging-hero-1080.avif 1080w, /images/packaging/packaging-hero-1440.avif 1440w" sizes="(max-width: 760px) 100vw, 50vw">
        <img src="/images/packaging/packaging-hero-1080.webp" srcset="/images/packaging/packaging-hero-720.webp 720w, /images/packaging/packaging-hero-1080.webp 1080w, /images/packaging/packaging-hero-1440.webp 1440w" sizes="(max-width: 760px) 100vw, 50vw" alt="" width="1080" height="1440" fetchpriority="high">
      </picture>
      <div class="half-inner">
        <span class="half-label">Olira Packaging</span>
        <h2 id="pack-title">Kraft paper bags</h2>
        <p>Twisted and flat handle paper bags, made to your size and printed with your logo.</p>
        <ul class="pills" aria-label="Bag options">
          <li><a href="/packaging/?handle=twisted#studio">Twisted handles</a></li>
          <li><a href="/packaging/?handle=flat#studio">Flat handles</a></li>
          <li><a href="/packaging/#studio">Custom print</a></li>
        </ul>
        <a class="half-cta" href="/packaging/" aria-describedby="pack-title">Design your bag</a>
      </div>
    </article>

    <svg class="contours" data-contours={contoursUrl} aria-hidden="true" focusable="false"></svg>
  </main>

  <footer class="split-contact">
    <address class="items">
      <a href={contact.phoneHref} data-contact="phone"><span class="k">Phone</span><span>{contact.phone}</span></a>
      <a href={contact.whatsappHref} target="_blank" rel="noopener" data-contact="whatsapp"><span class="k">WhatsApp</span><span>{contact.phone}</span></a>
      <a href={`mailto:${contact.email}`} data-contact="email"><span class="k">Email</span><span>{contact.email}</span></a>
      <span><span class="k">Office</span><span data-contact="office-short">{contact.officeShort}</span></span>
    </address>
    <span class="note">© <span data-year>{new Date().getFullYear()}</span> Olira Agro Industry</span>
  </footer>

  <script>import '../scripts/common.js';</script>
</SiteLayout>
