        </div>

        <div class="bg-gradient-to-br from-primary-100 to-primary-200 rounded-2xl p-12 h-80 flex flex-col items-center justify-center text-center animate-slideInRight">
          <p class="font-heading text-7xl font-bold text-primary-900 mb-4">16+</p>
          <p class="text-2xl font-bold text-primary-900">Years of Excellence</p>
          <div class="mt-8 pt-8 border-t-2 border-primary-300 w-full">
            <p class="text-primary-600 font-bold">Since 2008</p>
            <p class="text-primary-900 text-sm">Serving global markets</p>
