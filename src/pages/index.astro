      <style>
        /* Tall scroll track — 4 slides ≈ one viewport each */
        .pinned-fac { position: relative; height: 360vh; margin: 6rem 0; }
        .pinned-fac__sticky {
          position: sticky; top: 0; height: 100vh;
          display: flex; align-items: center; overflow: hidden;
        }
        .pinned-fac__stage { position: relative; min-height: 340px; }
        /* Non-active slides snap to hidden instantly (transition:none) so they
           never paint on top of the incoming slide. Only the slide that
           BECOMES active animates in. This kills the ghost/double-text
           artifact from two slides cross-fading at once. */
        .pinned-fac__slide {
          position: absolute; inset: 0;
          opacity: 0; visibility: hidden;
          transform: translateY(24px);
          transition: none;
          pointer-events: none;
          z-index: 1;
        }
        .pinned-fac__slide.is-active {
          opacity: 1; visibility: visible;
          transform: none;
          pointer-events: auto;
          z-index: 2;
          transition: opacity .55s cubic-bezier(.22,1,.36,1),
                      transform .55s cubic-bezier(.22,1,.36,1);
        }
        @media (max-width: 1023px) {
          /* On small screens: don't pin — stack slides as normal flow */
          .pinned-fac { height: auto; margin: 4rem 0; }
          .pinned-fac__sticky { position: static; height: auto; display: block; }
          .pinned-fac__stage { min-height: 0; }
          .pinned-fac__slide {
            position: static; opacity: 1; transform: none;
            pointer-events: auto; margin-top: 3rem;
          }
          .pinned-fac__slide:first-child { margin-top: 2.5rem; }
        }
        @media (prefers-reduced-motion: reduce) {
          .pinned-fac__slide { transition: none; }
        }
      </style>

      <script is:inline>
        (function () {
          const root = document.querySelector('[data-pinned-fac]');
          if (!root) return;
          const slides = root.querySelectorAll('[data-pf-slide]');
          const counter = root.querySelector('[data-pf-current]');
          const bar = root.querySelector('[data-pf-bar]');
          const count = slides.length;
          // Skip the pinned behavior on small screens (CSS already stacks them)
          const mq = window.matchMedia('(min-width: 1024px)');
          let active = -1, ticking = false;

          function setActive(i) {
            if (i === active) return;
            active = i;
            slides.forEach((s, idx) => {
              const on = idx === i;
              s.classList.toggle('is-active', on);
              s.setAttribute('aria-hidden', on ? 'false' : 'true');
            });
            if (counter) counter.textContent = String(i + 1).padStart(2, '0');
            if (bar) bar.style.width = (((i + 1) / count) * 100) + '%';
          }

          function update() {
            ticking = false;
            if (!mq.matches) { setActive(0); return; }
            const rect = root.getBoundingClientRect();
            const total = root.offsetHeight - window.innerHeight;
            // progress 0→1 across the pinned track
            const p = Math.min(1, Math.max(0, -rect.top / total));
            const idx = Math.min(count - 1, Math.floor(p * count));
            setActive(idx);
          }

          window.addEventListener('scroll', () => {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          window.addEventListener('resize', update);
          update();
        })();
      </script>

      <!-- Certifications Showcase (cards rendered client-side from /api/certifications) -->
      <CertificationShowcase />
    </div>
  </section>

  <!-- Why Choose Section -->
