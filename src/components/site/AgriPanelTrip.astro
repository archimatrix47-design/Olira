---
// The trip between the home page and the agriculture page: the green panel grows
// from its half of the home page to fill the screen and becomes the agriculture
// page's first screen, its four tiles move into their row, and the packaging
// panel is pushed off to the right; going back plays it in reverse (the motion
// is in site.css, "PAGE TRANSITIONS").
// The names are given for that one trip only: on the old page just before it is
// captured (pageswap), on the new page before its first frame (pagereveal). Every
// other page change stays a plain crossfade. The trip runs only when the panel is
// on screen and the new page opens at its top (no #section).
// Inline in <head>, so it is listening before the new page's first frame (a
// module script can run too late). It marks <html data-revealed> at the first
// frame, data-trip while the trip runs and data-came="panel" after one (the
// entrances are skipped: the panel was the entrance), and fires "agri:arrived"
// when the page is ready to be used (agri.js waits for it).
---
<script is:inline>
(() => {
  const KEY = 'olira-panel-trip';
  const HOME = '/', AGRI = '/agriculture/';
  const html = document.documentElement;
  const panel = () => document.querySelector('[data-agri-panel]');
  const across = () => (location.pathname === HOME ? AGRI : location.pathname === AGRI ? HOME : '');
  const onScreen = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    return r.top < innerHeight / 2 && r.bottom > innerHeight / 2;
  };
  const name = (on) => {
    const p = panel();
    if (!p) return;
    p.style.viewTransitionName = on ? 'agri-panel' : '';
    for (const t of p.querySelectorAll('[data-p]')) {
      t.style.viewTransitionName = on ? 'agri-tile-' + t.dataset.p : '';
      const label = t.querySelector('span'); // its own name, so it glides once instead of showing twice while the tile changes shape
      if (label) label.style.viewTransitionName = on ? 'agri-label-' + t.dataset.p : '';
    }
    const pack = document.querySelector('.door-pack');
    if (pack) pack.style.viewTransitionName = on ? 'pack-panel' : '';
  };
  const arrived = () => document.dispatchEvent(new CustomEvent('agri:arrived'));

  addEventListener('pageswap', (e) => {
    name(false);
    let go = false;
    try {
      const entry = e.viewTransition && e.activation && e.activation.entry;
      const to = entry && new URL(entry.url);
      go = Boolean(to) && to.origin === location.origin && to.pathname === across() && !to.hash && onScreen(panel());
      if (go) sessionStorage.setItem(KEY, to.pathname); else sessionStorage.removeItem(KEY);
    } catch (_) { go = false; }
    if (go) name(true);
  });

  addEventListener('pagereveal', (e) => {
    name(false);
    let came = false;
    try { came = sessionStorage.getItem(KEY) === location.pathname; sessionStorage.removeItem(KEY); } catch (_) { came = false; }
    html.dataset.revealed = '1';
    if (!e.viewTransition || !came || location.hash || !onScreen(panel())) { arrived(); return; }
    name(true);
    html.dataset.came = 'panel';
    html.dataset.trip = '1';
    const done = () => { name(false); delete html.dataset.trip; arrived(); };
    e.viewTransition.finished.then(done, done);
  });
})();
</script>
