---
// Call, WhatsApp and Telegram as icons. The phone numbers are not in this
// markup: pressing an icon asks POST /api/contact/reveal (src/scripts/reach.js)
// and shows the number with Call, Open WhatsApp and Copy. That keeps them out of
// reach of scrapers that read HTML or the public API.
import { contact } from '../../lib/site-data';
interface Props { dir?: 'up' | 'down' }
const { dir = 'down' } = Astro.props;
---
<div class="reach" data-reach data-dir={dir}>
  <button class="reach-btn" type="button" data-reach-kind="phone" aria-label="Call Olira" title="Call" aria-expanded="false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.2 3.5h3.1l1.8 4.6-2.3 1.4a11.5 11.5 0 0 0 6.7 6.7l1.4-2.3 4.6 1.8v3.1a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2z"/></svg>
  </button>
  <button class="reach-btn" type="button" data-reach-kind="whatsapp" aria-label="Message Olira on WhatsApp" title="WhatsApp" aria-expanded="false">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.6 20.4l1.2-4.1a8.6 8.6 0 1 1 3.1 3z"/><path d="M9.1 8.3c.3-.5.8-.4 1-.1l.8 1.7c.1.3 0 .5-.2.7l-.5.5c.6 1.3 1.6 2.3 2.9 2.9l.5-.5c.2-.2.4-.3.7-.2l1.7.8c.3.2.4.7-.1 1-.7.6-1.5.8-2.3.5a8 8 0 0 1-4.9-4.9c-.3-.8-.1-1.6.5-2.3z" fill="currentColor" stroke="none"/></svg>
  </button>
  <a class="reach-btn" data-contact="telegram" href={contact.telegramHref || '#'} target="_blank" rel="noopener" aria-label={`Olira on Telegram ${contact.telegramLabel}`.trim()} title="Telegram" hidden={!contact.telegramHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 3.5L2.8 10.8l6.3 2.1 2.2 6.6 3.3-4.3 5.1 3.7z"/><path d="M9.1 12.9l12.4-9.4"/></svg>
  </a>
  <div class="reach-pop" role="group" aria-live="polite" hidden></div>
</div>
