---
// The product carousel, shared by the agriculture range and the packaging
// catalogue so both show their products the same way: a ring of cards, a
// caption, arrows and dots, and the front card growing into its detail panel.
// Behaviour is in src/scripts/flow.js (mountFlow); cards come from cardHTML there.
//
// prefix '' keeps the agriculture page's original ids (flow, flowTrack, capName…);
// any other prefix namespaces them (pkFlow, pkFlowTrack…). The default slot holds
// the detail panel's actions.
import { cardHTML } from '../../scripts/flow.js';
interface Item { id: string; name: string; sub?: string; image?: string | null; cat?: string; print?: { cutout: string; quad: number[][]; safeTop?: number } | null }
interface Props { items: Item[]; label: string; prefix?: string; kind: string; start?: number }
const { items, label, prefix = '', kind, start = 0 } = Astro.props;
const id = (s: string) => (prefix ? prefix + s[0].toUpperCase() + s.slice(1) : s);
const N = items.length;
const first = items[start];
const openIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
const arrow = (d: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
---
<div class="flow-wrap" data-flow={kind}>
  <div class="flow" id={id('flow')} tabindex="0" role="region" aria-roledescription="carousel" aria-label={label} aria-describedby={id('flowHelp')}>
    <ul class="flow-track" id={id('flowTrack')} set:html={items.map((p, i) => cardHTML(p, i, start, N)).join('')}></ul>
  </div>
  <slot name="after-track" />
  <p class="sr-only" id={id('flowHelp')}>Use the left and right arrow keys to browse. Press Enter to open the product details.</p>
  <div class="flow-bar">
    <button class="round-btn flow-prev" id={id('flowPrev')} type="button" aria-label="Previous product"><Fragment set:html={arrow('M15 6l-6 6 6 6')} /></button>
    <div class="flow-cap" aria-live="polite">
      <h3 id={id('capName')}>{first?.name}</h3>
      <p id={id('capSub')}>{first?.sub}</p>
    </div>
    <button class="round-btn flow-next" id={id('flowNext')} type="button" aria-label="Next product"><Fragment set:html={arrow('M9 6l6 6-6 6')} /></button>
  </div>
  <div class="flow-actions">
    <button class="btn btn-secondary btn-sm flow-open-btn" id={id('flowOpen')} type="button" aria-describedby={id('capName')}><Fragment set:html={openIcon} />View details</button>
  </div>
  <div class="flow-dots" id={id('flowDots')} role="group" aria-label="Choose a product">
    {items.map((p, i) => <button type="button" aria-label={p.name} aria-current={String(i === start)}></button>)}
  </div>
  <p class="flow-hint" aria-hidden="true"><span class="on-touch">Tap the front card for details. Swipe to see more products.</span><span class="on-mouse">Click the front card for details. Use the arrows or drag to see more products.</span></p>

  <div class="flow-detail" id={id('flowDetail')} hidden role="dialog" aria-modal="true" aria-labelledby={id('detName')}>
    <div class="detail-box" id={id('detailBox')}>
      <div class="detail-media"><img id={id('detImg')} src={first?.image || '/logo.png'} alt="" width="800" height="1000" decoding="async"><slot name="media" /></div>
      <div class="detail-body">
        <button class="round-btn detail-close" id={id('detClose')} type="button" aria-label="Close details">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <p class="note det-cat" id={id('detCat')}></p>
        <h3 class="det-name" id={id('detName')}></h3>
        <p class="detail-desc" id={id('detDesc')}></p>
        <dl class="spec-list" id={id('detSpec')}></dl>
        <ul class="detail-specs" id={id('detSpecs')}></ul>
        <slot />
      </div>
    </div>
  </div>
</div>
