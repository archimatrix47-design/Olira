---
// The packaging panel's products, standing together in true proportion: on the
// home page (printed with Olira's logo) and along the bottom of the packaging
// page's first screen (printed with the visitor's brand as they type). Each
// product's share of the row (--w) comes from its true height and its cut-out's
// proportions, so the row always fits. lineup.js keeps it in step with the live
// catalogue; live-print.js prints on it. data-id gives each product its name for
// the trip between the two pages (PanelTrip.astro).
import { packagingProducts } from '../../lib/site-data';
import { cutoutOf, standHTML } from '../../scripts/catalogue-panel.js';
import { LINEUP } from '../../lib/panels';

interface Props { brand?: '' | 'olira' }
const { brand = '' } = Astro.props;

type Stood = { p: any; c: any; h: number; w: number };
const got = LINEUP.map(([id, h]) => {
  const p = packagingProducts.find((x) => x.id === id);
  const c = p && cutoutOf(p);
  return c ? { p, c, h } : null;
}).filter(Boolean) as Omit<Stood, 'w'>[];
const units = got.map((x) => x.h * x.c.width / x.c.height);
const total = units.reduce((a, b) => a + b, 0) || 1;
const room = 100 - 4 * (got.length - 1);
const items: Stood[] = got.map((x, i) => ({ ...x, w: +(units[i] / total * room).toFixed(2) }));
---
<div class="lineup" data-lineup data-brand={brand || undefined} aria-hidden="true">
  {items.map(({ c, p, w, h }, i) => (
    <div class="item" style={`--w:${w}`} data-name={p.name} data-id={p.id} data-h={h}>
      <Fragment set:html={standHTML(c, p.name, { eager: i < 3, brand })} />
    </div>
  ))}
</div>
