---
// FloatingContact.astro — persistent quick-contact FABs (WhatsApp / Telegram).
// In agri-export trade these are how deals actually start, so they stay in reach
// on every scroll position. URLs come from the SAME source as the footer/social
// icons (/api/social-links, managed in the admin Social tab): each FAB stays
// hidden until its URL is configured, so no dead button ever shows. Positioned
// bottom-LEFT so it never collides with the back-to-top button (bottom-right).
// One <script> hydrates it from a single fetch.
const platforms = [
  {
    key: 'whatsapp',
    label: 'WhatsApp',
    size: 22,
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.546 4.142 1.588 5.945L0 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.359 11.949-11.893A11.821 11.821 0 0 0 20.52 3.45',
  },
  {
    key: 'telegram',
    label: 'Telegram',
    size: 22,
    path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  },
];
---

<div
  id="floating-contact"
  class="hidden fixed left-4 bottom-4 sm:left-6 sm:bottom-6 z-40 flex-col items-start gap-3"
  data-floating-contact
>
  {platforms.map((p) => (
    <a
      data-fc={p.key}
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Message us on ${p.label}`}
      class="fc-item hidden group relative items-center"
    >
      <span class="fc-fab w-12 h-12 rounded-full bg-primary-600 text-white flex items-center justify-center shadow-e2 ring-1 ring-black/5 transition-transform duration-300 group-hover:-translate-y-0.5 group-active:scale-95">
        <svg width={p.size} height={p.size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={p.path} /></svg>
      </span>
      <span class="fc-label ml-3 whitespace-nowrap font-sans text-sm font-semibold text-ink bg-surface px-3 py-1.5 rounded-full shadow-e2 ring-1 ring-line max-w-0 overflow-hidden opacity-0 -translate-x-2 pointer-events-none transition-all duration-300 ease-out group-hover:max-w-[160px] group-hover:opacity-100 group-hover:translate-x-0">
        {p.label}
      </span>
    </a>
  ))}
</div>

<style>
  /* Gentle attention pulse on the FAB ring — respects reduced motion. */
  .fc-fab { position: relative; }
  .fc-fab::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    box-shadow: 0 0 0 0 rgb(var(--p-600) / 0.45);
    animation: fcPulse 2.6s ease-out infinite;
  }
  @keyframes fcPulse {
    0%   { box-shadow: 0 0 0 0 rgb(var(--p-600) / 0.4); }
    70%  { box-shadow: 0 0 0 12px rgb(var(--p-600) / 0); }
    100% { box-shadow: 0 0 0 0 rgb(var(--p-600) / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fc-fab::after { animation: none; }
    .fc-item, .fc-fab, .fc-label { transition: none !important; }
  }
  /* On touch screens the hover-label never triggers; keep labels collapsed and
     rely on the recognisable glyph + aria-label. */
  @media (hover: none) {
    .fc-label { display: none; }
  }
</style>

<script>
  // Reveal only the platforms with a configured URL, from a single request.
  (async function hydrateFloatingContact() {
    const root = document.querySelector('[data-floating-contact]');
    if (!root) return;
    let links: Record<string, string> = {};
    try {
      const res = await fetch('/api/social-links');
      if (res.ok) links = await res.json();
    } catch (e) { /* leave hidden on failure — never show a dead button */ }

    let any = false;
    root.querySelectorAll('[data-fc]').forEach((a) => {
      const url = links[(a as HTMLElement).getAttribute('data-fc') || ''];
      if (url) {
        a.setAttribute('href', url);
        a.classList.remove('hidden');
        a.classList.add('flex');
        any = true;
      }
    });
    if (any) {
      root.classList.remove('hidden');
      root.classList.add('flex');
    }
  })();
</script>
