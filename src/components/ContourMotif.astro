---
// ContourMotif.astro — the signature graphic of the "terroir" direction.
//
// These are REAL topographic contour lines of Burayu, Oromia — where Olira's
// processing facility sits, in the Ethiopian highlands. Traced with marching
// squares from an SRTM elevation grid (2061–3297 m of genuine relief) and baked
// to burayu-contours.json, so the site ships the actual shape of the land with
// no runtime dependency. It's the terroir made literal: a fingerprint no
// competitor's template can have, because it's a specific place.
import contours from '../data/burayu-contours.json';

export interface Props {
  size?: number;      // rendered px (square)
  class?: string;
  opacity?: number;   // overall wash
}
const { size = 640, class: className = '', opacity = 0.55 } = Astro.props;
const VB = contours.size; // 1000
---

<svg
  class:list={["contour-motif", className]}
  viewBox={`0 0 ${VB} ${VB}`}
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label={`Topographic contour lines of ${contours.place}, elevation ${contours.elevationRange[0]}–${contours.elevationRange[1]} metres`}
  style={`opacity:${opacity}`}
>
  {contours.levels.map((lvl) => (
    <path
      d={lvl.d}
      stroke="currentColor"
      stroke-width={0.9 + lvl.rank * 0.9}
      stroke-opacity={0.3 + lvl.rank * 0.55}
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
  ))}
</svg>
