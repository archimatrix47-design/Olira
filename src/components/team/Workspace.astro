---
// Staff workspace, one page per role: the agriculture and packaging marketing
// teams, and the manager. Each view is picked from the URL hash. A team member
// sees only their line's enquiries and edits their line's catalogue; the
// manager sees every enquiry in both lines and the numbers. The server enforces
// all of it on every request.
import '../../styles/tokens.css';
import '../../styles/ambient.css';
import '../../styles/site.css';
import '../../styles/admin.css';
import '../../styles/admin-insights.css';
import '../../styles/team.css';
import ThemeButton from '../site/ThemeButton.astro';
import { SOCIAL_PLATFORMS } from '../../../lib/social.js';
import Dashboard from './views/Dashboard.astro';
import Traffic from './views/Traffic.astro';
import Report from './views/Report.astro';
import AgriProducts from './views/AgriProducts.astro';
import PackProducts from './views/PackProducts.astro';

interface Props { line: 'agri' | 'pack' | 'manager' }
const { line } = Astro.props;
const pack = line === 'pack';
const manager = line === 'manager';
const team = !manager;
const teamName = manager ? 'Manager' : pack ? 'Packaging' : 'Agriculture';
const home = manager ? '/team/manager/' : `/team/${pack ? 'packaging' : 'agriculture'}/`;
// one expression: Astro moves text beside an expression out of <title>
const title = `${teamName} workspace, Olira`;
const PERIODS: [number, string][] = [[7, 'Last 7 days'], [30, 'Last 30 days'], [90, 'Last 90 days'], [365, 'Last 12 months']];

const icon: Record<string, string> = {
  inbox: '<path d="M4 13h4l2 3h4l2-3h4"/><path d="M5.5 5h13L21 13v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6z"/>',
  followups: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  quotes: '<path d="M7 3h7l5 5v12a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  mockups: '<path d="M6 8h12l1.2 12.5a1 1 0 01-1 1.1H5.8a1 1 0 01-1-1.1z"/><path d="M9 8V6.5a3 3 0 016 0V8"/>',
  minimums: '<path d="M4 7h16M4 12h10M4 17h6"/><path d="M17 14v6M14 17h6"/>',
  products: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
  dashboard: '<path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z"/>',
  pipeline: '<rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="11" rx="1.5"/><rect x="17" y="4" width="4" height="7" rx="1.5"/>',
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0111 0"/><circle cx="17" cy="9.5" r="2.5"/><path d="M15.5 14.4A4.5 4.5 0 0121 18.8"/>',
  report: '<path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/>',
  traffic: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  social: '<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/>',
  partners: '<rect x="3" y="7" width="7" height="10" rx="1.5"/><rect x="14" y="7" width="7" height="10" rx="1.5"/><path d="M10 12h4"/>',
  account: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/>',
};
const nav: { label: string, items: string[][] }[] = manager ? [
  { label: 'Daily', items: [['dashboard', 'Dashboard'], ['inbox', 'Enquiries'], ['pipeline', 'Pipeline'], ['followups', 'Follow-ups']] },
  { label: 'Sales', items: [['quotes', 'Quotes'], ['people', 'Team performance'], ['report', 'Report']] },
  { label: 'Website', items: [['traffic', 'Traffic'], ['products', 'Products']] },
  { label: 'You', items: [['account', 'My account']] },
] : [
  { label: 'Sales', items: [['inbox', 'Inbox'], ['followups', 'Follow-ups'], ['quotes', 'Quotes'], ...(pack ? [['mockups', 'Mockups']] : [])] },
  { label: 'Website', items: [['products', pack ? 'Packaging products' : 'Agriculture products'], ...(pack ? [['minimums', 'Minimum orders']] : []), ['social', 'Contact links'], ['partners', 'Partner logos']] },
  { label: 'You', items: [['account', 'My account']] },
];
const Svg = (name: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<script is:inline>(function(){try{var s=localStorage.getItem('olira-theme');if(s==='dark'||s==='light')document.documentElement.setAttribute('data-theme',s);}catch(e){}})();</script>
<title>{title}</title>
<link rel="icon" type="image/png" href="/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
</head>
<body class="admin-body team-body" data-line={line}>
<a class="skip" href="#teamMain">Skip to content</a>

<header class="a-top">
  <a class="a-brand" href={home}><img src="/logo.png" alt="Olira" width="68" height="32" data-brand-logo><span>{teamName} workspace</span></a>
  <div class="a-top-actions">
    <span class="t-user" id="teamUser" hidden></span>
    <ThemeButton />
    <button class="btn btn-secondary" type="button" id="teamSignOut" hidden>Sign out</button>
  </div>
</header>

<!-- Signing in happens once, at /team/. An unsigned visit goes back there and
     returns to this page on its own. -->
<main class="a-login" id="teamLogin" hidden>
  <div class="a-card a-login-card">
    <h1>{teamName} workspace</h1>
    <p id="teamGateNote">Taking you to sign in.</p>
    <a class="btn btn-primary btn-lg" id="teamGateAction" href="/team/">Sign in</a>
  </div>
</main>

<div class="a-shell t-shell" id="teamPanel" hidden>
  <nav class="a-side" aria-label="Workspace sections">
    {nav.map((g) => (
      <div class="a-side-group">
        <p>{g.label}</p>
        {g.items.map(([id, label]) => (
          <a class="a-nav-link" href={`#${id}`} data-nav={id}>
            <Fragment set:html={Svg(id)} />{label}
            {(id === 'inbox' || id === 'followups') && <span class="a-count" data-count={id} hidden></span>}
          </a>
        ))}
      </div>
    ))}
  </nav>

  <main id="teamMain" tabindex="-1">
    <a class="a-back" href="#menu">All sections</a>
    {manager && <Dashboard />}
    <!-- INBOX: for the manager, every enquiry in both lines -->
    <section class="a-view" data-view="inbox" aria-labelledby="h-inbox" hidden>
      <div class="t-inbox-head">
        <h1 id="h-inbox">{manager ? 'Enquiries' : 'Inbox'}</h1>
        <ul class="t-summary" id="inboxKpis" aria-label={manager ? 'Numbers for both lines' : 'Your numbers'}></ul>
        <div class="row" style="--gap:6px">
          {manager && <button class="btn btn-ghost btn-sm" type="button" id="inboxCsv">Download CSV</button>}
          <button class="btn btn-ghost btn-sm" type="button" id="inboxRefresh">Refresh</button>
        </div>
      </div>
      <div class="a-card t-toolbar">
        <div class="a-seg" role="radiogroup" aria-label="Show">
          <label><input type="radio" name="inboxFilter" value="unassigned" checked><span>{manager ? 'Not handed out' : 'To accept'} <b data-filter-count="unassigned"></b></span></label>
          {team && <label><input type="radio" name="inboxFilter" value="mine"><span>Mine <b data-filter-count="mine"></b></span></label>}
          <label><input type="radio" name="inboxFilter" value="open"><span>All open <b data-filter-count="open"></b></span></label>
          <label><input type="radio" name="inboxFilter" value="closed"><span>Closed <b data-filter-count="closed"></b></span></label>
          {manager && <label><input type="radio" name="inboxFilter" value="all"><span>Everything <b data-filter-count="all"></b></span></label>}
        </div>
        <div class="t-toolbar-row">
          <label class="sr-only" for="inboxSearch">Search enquiries</label>
          <input class="input grow" id="inboxSearch" type="search" placeholder="Search name, company, email or message" aria-keyshortcuts="/">
          {manager && (
            <Fragment>
              <label class="sr-only" for="inboxLine">Business line</label>
              <select class="input" id="inboxLine">
                <option value="all">Both lines</option>
                <option value="agri">Agriculture</option>
                <option value="pack">Packaging</option>
              </select>
              <label class="sr-only" for="inboxOwner">Handled by</label>
              <select class="input" id="inboxOwner"><option value="">Anyone</option></select>
            </Fragment>
          )}
          <label class="sr-only" for="inboxSort">Sort</label>
          <select class="input" id="inboxSort">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="score">Strongest leads first</option>
          </select>
        </div>
        <p class="sr-only" id="inboxSummary" role="status" aria-live="polite"></p>
      </div>
      <div class="t-inbox">
        <ul class="t-list" id="inboxList" aria-label="Enquiries"></ul>
        <article class="t-detail a-card" id="leadDetail" aria-live="off">
          <div class="a-empty"><strong>Choose an enquiry</strong>{manager ? 'Hand it to someone on its team, or reply and quote yourself.' : pack ? 'Accept one to make it yours, then reply, send a mockup and quote.' : 'Accept one to make it yours, then reply and quote.'}</div>
        </article>
      </div>
    </section>

    {manager && (
      <section class="a-view" data-view="pipeline" aria-labelledby="h-pipeline" hidden>
        <div class="a-head">
          <div>
            <h1 id="h-pipeline">Pipeline</h1>
            <p>Every open enquiry by stage, with the value of the quotes in each. Open a card to work the enquiry.</p>
          </div>
          <div class="a-head-tools">
            <div class="a-seg" role="radiogroup" aria-label="Business line">
              <label><input type="radio" name="pipeLine" value="all" checked><span>Both lines</span></label>
              <label><input type="radio" name="pipeLine" value="agri"><span>Agriculture</span></label>
              <label><input type="radio" name="pipeLine" value="pack"><span>Packaging</span></label>
            </div>
            <label class="a-period"><span>Handled by</span><select class="input" id="pipeOwner"><option value="">Anyone</option></select></label>
          </div>
        </div>
        <p class="t-follow-sum" id="pipeSummary" aria-live="polite"></p>
        <div class="t-board" id="pipeBoard" aria-label="Enquiries by stage"></div>
      </section>
    )}

    <!-- FOLLOW-UPS -->
    <section class="a-view" data-view="followups" aria-labelledby="h-followups" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-followups">Follow-ups</h1>
          <p>{manager ? 'Enquiries that are waiting on someone, in both lines, with who holds each. Buyers who hear back within a day are far more likely to order.' : 'Enquiries that are waiting on you. Buyers who hear back within a day are far more likely to order, so start at the top.'}</p>
        </div>
      </div>
      <p class="t-follow-sum" id="followupSum" aria-live="polite"></p>
      <div id="followupList" class="t-follow"></div>
    </section>

    <!-- QUOTES -->
    <section class="a-view" data-view="quotes" aria-labelledby="h-quotes" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-quotes">Quotes</h1>
          <p>Every quote saved on an enquiry, newest first. Open one to follow up, or print it again.</p>
        </div>
      </div>
      <div class="a-card"><div class="a-scroll" id="quoteTable"></div></div>
    </section>

    {manager && (
      <Fragment>
        <section class="a-view" data-view="people" aria-labelledby="h-people" hidden>
          <div class="a-head">
            <div>
              <h1 id="h-people">Team performance</h1>
              <p>How each person is doing with the enquiries they hold: how fast they answer, what they quote and what they win. Enquiries count in the period they arrived.</p>
            </div>
            <label class="a-period"><span>Period</span>
              <select class="input" data-period>{PERIODS.map(([v, t]) => <option value={v} selected={v === 30}>{t}</option>)}</select>
            </label>
          </div>
          <div class="a-kpis" id="peopleKpis" aria-label="Team numbers"></div>
          <div class="a-card">
            <div class="a-card-head"><div><h2>People</h2><p>Open is everything they hold now, whatever the period. Overdue is follow-ups past due.</p></div></div>
            <div class="a-scroll" id="peopleTable"></div>
          </div>
          <div class="a-grid12">
            <div class="a-card span-6">
              <div class="a-card-head"><div><h2>Workload</h2><p>Open enquiries each person holds now.</p></div></div>
              <div id="peopleLoad"></div>
            </div>
            <div class="a-card span-6">
              <div class="a-card-head"><div><h2>Won in the period</h2><p>Quote value on enquiries marked Won, by who won them.</p></div></div>
              <div id="peopleWon"></div>
            </div>
          </div>
        </section>
        <Report />
        <Traffic />
        <section class="a-view" data-view="products" aria-labelledby="h-products" hidden>
          <div class="a-head">
            <div>
              <h1 id="h-products">Products</h1>
              <p>Which products draw interest and enquiries, and how complete each is on the website. The marketing teams edit the catalogues in their workspaces.</p>
            </div>
            <label class="a-period"><span>Period</span>
              <select class="input" data-period>{PERIODS.map(([v, t]) => <option value={v} selected={v === 30}>{t}</option>)}</select>
            </label>
          </div>
          <div class="a-card">
            <div class="a-card-head"><div><h2>Agriculture products</h2><p>Details opened on the agriculture page, enquiries that named the product, and how complete its content is. Sorted by interest.</p></div></div>
            <div id="prPerformance"></div>
          </div>
          <div class="a-card">
            <div class="a-card-head"><div><h2>Packaging products</h2><p>How often each product was asked for in a packing list or a studio design this period, and what it still needs on the website.</p></div></div>
            <div id="pkPerformance"></div>
          </div>
        </section>
      </Fragment>
    )}

    {pack && (
      <section class="a-view" data-view="mockups" aria-labelledby="h-mockups" hidden>
        <div class="a-head">
          <div>
            <h1 id="h-mockups">Mockups</h1>
            <p>Put a client's logo on any of our bags, download the picture, or save it to their enquiry to send with a reply.</p>
          </div>
        </div>
        <div class="studio t-studio">
          <div class="a-card stage">
            <canvas class="stage-canvas" id="tmCanvas" width="1200" height="1680" tabindex="0" role="img" aria-label="Bag mockup preview" aria-describedby="tmInfo tmHelp"></canvas>
            <div class="stage-meta">
              <span class="note" id="tmHelp">Drag the design on the bag, or focus the preview and use the arrow keys.</span>
              <span class="note" id="tmInfo"></span>
            </div>
          </div>
          <div class="a-card panel">
            <p class="sr-only" id="tmStatus" role="status" aria-live="polite"></p>
            <div class="a-field">
              <label for="tmLead">For enquiry</label>
              <select class="input" id="tmLead"><option value="">No enquiry, just a picture</option></select>
            </div>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Bag</legend>
              <div class="t-bags" id="tmBags"></div>
            </fieldset>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Size</legend>
              <!-- the chosen product's own sizes, filled in by mockups.js -->
              <div class="chips" id="tmSizes"></div>
            </fieldset>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Design</legend>
              <div class="a-seg" role="radiogroup" aria-label="Design">
                <label><input type="radio" name="tmMode" value="brand" checked><span>Logo and text</span></label>
                <label><input type="radio" name="tmMode" value="artwork"><span>Full artwork</span></label>
              </div>
            </fieldset>
            <!-- full artwork: the client's finished design across the print area -->
            <div class="a-field" data-tm-mode="artwork" hidden>
              <span class="a-label" id="tmArtLabel">Artwork</span>
              <label class="a-drop" id="tmArtDrop">
                <input type="file" id="tmArtFile" accept="image/png,image/jpeg,image/webp,image/svg+xml" aria-labelledby="tmArtLabel tmArtTitle" aria-describedby="tmArtHint">
                <strong id="tmArtTitle">Upload the artwork</strong>
                <span>The finished design, the whole page: PNG, JPG, WebP or SVG.</span>
              </label>
              <div class="a-field" id="tmArtFromLeadWrap" hidden>
                <label for="tmArtFromLead">Or use a file the client sent</label>
                <select class="input" id="tmArtFromLead"></select>
              </div>
              <div class="a-seg" role="radiogroup" aria-label="Fit">
                <label><input type="radio" name="tmFit" value="cover" checked><span>Fill the print area</span></label>
                <label><input type="radio" name="tmFit" value="contain"><span>Show all of it</span></label>
              </div>
              <p class="a-note" id="tmArtHint"></p>
              <p class="t-logo-note" id="tmArtAdvice" hidden></p>
              <button class="btn btn-ghost btn-sm" type="button" id="tmRemoveArt" hidden style="justify-self:start">Remove artwork</button>
            </div>
            <div class="a-field" data-tm-mode="brand">
              <span class="a-label" id="tmLogoLabel">Logo</span>
              <div class="t-logo-sources">
                <label class="a-drop" id="tmDrop">
                  <input type="file" id="tmLogoFile" accept="image/png,image/jpeg,image/svg+xml,image/webp" aria-labelledby="tmLogoLabel tmDropTitle">
                  <strong id="tmDropTitle">Upload a logo</strong>
                  <span>PNG, JPG, SVG or WebP from your computer.</span>
                </label>
                <div class="a-field" id="tmFromLeadWrap" hidden>
                  <label for="tmFromLead">Or use a file the client sent</label>
                  <select class="input" id="tmFromLead"></select>
                </div>
              </div>
              <!-- the same logo check as the public studio, with its fixes -->
              <div class="t-logo-note" id="tmLogoAdvice" hidden>
                <p id="tmLogoAdviceText"></p>
                <div class="row" style="--gap:8px;flex-wrap:wrap;margin-top:8px">
                  <button class="btn btn-secondary btn-sm" type="button" id="tmFixBox" hidden>Remove the white box</button>
                  <button class="btn btn-secondary btn-sm" type="button" id="tmFixInk" hidden>Print it in the ink colour</button>
                </div>
              </div>
              <div class="row" style="justify-content:space-between;--gap:10px;flex-wrap:wrap">
                <label class="a-check"><input type="checkbox" id="tmOneInk"> Print the logo in the ink colour</label>
                <button class="btn btn-ghost btn-sm" type="button" id="tmRemoveLogo" hidden>Remove logo</button>
              </div>
            </div>
            <div class="a-two" data-tm-mode="brand">
              <div class="a-field"><label for="tmText1">Main text</label><input class="input" id="tmText1" maxlength="18" autocomplete="off"></div>
              <div class="a-field"><label for="tmText2">Second line</label><input class="input" id="tmText2" maxlength="28" autocomplete="off"></div>
            </div>
            <fieldset class="a-fieldset a-field" data-tm-mode="brand">
              <legend class="a-label">Ink colour</legend>
              <div class="chips">
                <label class="opt opt-swatch" title="Black"><input type="radio" name="tmInk" value="black"><span style="--sw:#1E1B16"></span><b class="sr-only">Black</b></label>
                <label class="opt opt-swatch" title="Teal"><input type="radio" name="tmInk" value="teal" checked><span style="--sw:#186078"></span><b class="sr-only">Teal</b></label>
                <label class="opt opt-swatch" title="Leaf green"><input type="radio" name="tmInk" value="leaf"><span style="--sw:#4A5E17"></span><b class="sr-only">Leaf green</b></label>
                <label class="opt opt-swatch" title="Red"><input type="radio" name="tmInk" value="red"><span style="--sw:#A3301E"></span><b class="sr-only">Red</b></label>
                <label class="opt opt-swatch" title="White"><input type="radio" name="tmInk" value="white"><span style="--sw:#FAF7F0"></span><b class="sr-only">White</b></label>
              </div>
            </fieldset>
            <div class="a-field">
              <label for="tmScale">Design size</label>
              <input class="range" id="tmScale" type="range" min="50" max="140" value="100" aria-valuetext="100 percent">
            </div>
            <div class="row" style="--gap:8px;flex-wrap:wrap">
              <button class="btn btn-secondary btn-sm" type="button" id="tmCentre">Centre design</button>
            </div>
            <div class="panel-actions">
              <button class="btn btn-secondary" type="button" id="tmDownloadPng">Download PNG</button>
              <button class="btn btn-secondary" type="button" id="tmDownloadJpg">Download JPG</button>
            </div>
            <button class="btn btn-primary btn-lg" type="button" id="tmSave" disabled>Save to the enquiry</button>
            <p class="a-note" id="tmSaveNote">Choose an enquiry above to save the mockup to it. Saved mockups can be attached to a reply.</p>
          </div>
        </div>
      </section>
    )}

    {line === 'agri' && <AgriProducts />}
    {pack && <PackProducts />}

    {pack && (
      <Fragment>
      <!-- MINIMUM ORDERS: what visitors can put in a packing list -->
      <section class="a-view" data-view="minimums" aria-labelledby="h-minimums" hidden>
        <div class="a-head">
          <div>
            <h1 id="h-minimums">Minimum orders</h1>
            <p>The smallest quantity a visitor can request, per product and, where it differs, per size. The packaging page and its packing list use these straight away, and a request below them is not accepted. Leave a size blank to use the product minimum; leave both blank to agree it in the quote.</p>
          </div>
        </div>
        <p class="sr-only" id="tMinLive" role="status" aria-live="polite"></p>
        <form class="t-min" id="tMinForm" novalidate>
          <div class="t-min-list" id="tMinList"><p class="note">Loading the products.</p></div>
          <div class="a-actions a-savebar"><span class="a-dirty a-grow" id="tMinDirty">Unsaved changes</span><button class="btn btn-primary" type="submit" id="tMinSave">Save minimums</button></div>
        </form>
      </section>
      </Fragment>
    )}

    {team && (
    <Fragment>
    <!-- CONTACT LINKS: the floating contact button and the footer, for both teams -->
    <section class="a-view" data-view="social" aria-labelledby="h-social" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-social">Contact links</h1>
          <p>WhatsApp, Telegram and the social pages in the floating contact button on every page of the website, and in the footer. Paste the full address of each profile; blank ones are hidden. The other marketing team can change these too.</p>
        </div>
      </div>
      <form class="a-form a-settings t-social-form" id="tSocialForm" novalidate>
        <div class="a-card a-group">
          {SOCIAL_PLATFORMS.map((p) => (
            <div class="a-field">
              <label for={`ts-${p.key}`}>{p.label}</label>
              <input class="input" id={`ts-${p.key}`} name={p.key} type="url" placeholder={p.placeholder} autocomplete="off" aria-describedby={`ts-${p.key}-err${p.hint ? ` ts-${p.key}-hint` : ''}`}>
              {p.hint && <p class="hint" id={`ts-${p.key}-hint`}>{p.hint}</p>}
              <p class="err" id={`ts-${p.key}-err`} hidden></p>
            </div>
          ))}
        </div>
        <div class="a-actions a-savebar"><span class="a-dirty a-grow">Unsaved changes</span><button class="btn btn-primary" type="submit" id="tSocialSave">Save contact links</button></div>
        <p class="sr-only" id="tSocialLive" role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- PARTNER LOGOS: the organisations on the home page, for both teams -->
    <section class="a-view" data-view="partners" aria-labelledby="h-partners" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-partners">Partner logos</h1>
          <p>The organisations Olira has worked with, moving slowly across the home page under the two businesses. Add a logo with the organisation's name, put them in order, and save. With none saved, the row is hidden. The other marketing team can change these too.</p>
        </div>
      </div>
      <div class="t-pt-layout">
        <div class="a-card t-pt-add">
          <h2>Add a logo</h2>
          <label class="a-drop" id="tPtDrop">
            <input type="file" id="tPtFile" accept="image/png,image/svg+xml,image/webp,image/jpeg" aria-labelledby="tPtDropTitle" aria-describedby="tPtHint">
            <img id="tPtPreview" alt="" hidden>
            <strong id="tPtDropTitle">Upload the logo</strong>
            <span id="tPtHint">The organisation's official logo, on a transparent background: SVG or PNG is best, up to 5 MB. Only show logos you have permission to use.</span>
          </label>
          <div class="a-field"><label for="tPtName">Organisation</label><input class="input" id="tPtName" maxlength="80" autocomplete="off" placeholder="Food and Agriculture Organization (FAO)"><p class="err" id="tPtNameErr" hidden></p></div>
          <div class="a-field"><label for="tPtUrl">Link (optional)</label><input class="input" id="tPtUrl" type="url" maxlength="300" autocomplete="off" placeholder="https://www.fao.org"><p class="err" id="tPtUrlErr" hidden></p></div>
          <button class="btn btn-secondary" type="button" id="tPtAdd" disabled>Add to the list</button>
        </div>
        <div class="a-card t-pt-listcard">
          <h2>On the home page</h2>
          <ol class="t-pt-list" id="tPtList" aria-label="Partner logos, in order"></ol>
          <p class="note" id="tPtEmpty">No logos yet. The row is hidden on the home page until the first one is saved.</p>
          <div class="t-ph-actions"><button class="btn btn-primary" type="button" id="tPtSave" disabled>Save partner logos</button><span class="note" id="tPtNote"></span></div>
        </div>
      </div>
      <p class="sr-only" id="tPtLive" role="status" aria-live="polite"></p>
    </section>
    </Fragment>
    )}

    <!-- ACCOUNT -->
    <section class="a-view" data-view="account" aria-labelledby="h-account" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-account">My account</h1>
          <p>Buyers' replies to the emails you send from here go to your work email. The site administrator creates accounts and can reset your password.</p>
        </div>
      </div>
      <div class="a-settings">
        <div class="a-card a-group">
          <h2>Signed in as</h2>
          <dl class="t-profile" id="accountProfile"></dl>
        </div>
        <form class="a-form" id="accountPassForm" novalidate>
          <div class="a-card a-group">
            <h2>Change password</h2>
            <div class="a-field"><label for="apCurrent">Current password</label><input class="input" id="apCurrent" type="password" autocomplete="current-password" required></div>
            <div class="a-field"><label for="apNew">New password</label><input class="input" id="apNew" type="password" autocomplete="new-password" minlength="12" required aria-describedby="apHint"><p class="hint" id="apHint">At least 12 characters.</p></div>
            <div class="a-field"><label for="apNew2">Type it again</label><input class="input" id="apNew2" type="password" autocomplete="new-password" required aria-describedby="apErr"><p class="err" id="apErr" role="alert" hidden></p></div>
          </div>
          <div class="a-actions a-savebar"><span class="a-dirty a-grow">Unsaved changes</span><button class="btn btn-primary" type="submit">Change password</button></div>
        </form>
      </div>
    </section>
  </main>
</div>

<!-- printable quote, filled in by quote.js -->
<div class="t-print" id="printSheet" aria-hidden="true"></div>

<div class="a-toasts" id="toasts" role="status" aria-live="polite"></div>
<dialog class="a-dialog" id="confirmDialog" aria-labelledby="confirmTitle">
  <form method="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmBody"></p>
    <div class="a-actions">
      <button class="btn btn-secondary" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="ok" id="confirmOk">Delete</button>
    </div>
  </form>
</dialog>

<script>import '../../scripts/team/main.js';</script>
</body>
</html>
