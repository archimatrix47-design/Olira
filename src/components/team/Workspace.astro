---
// Sales team workspace. One page per team (agriculture, packaging); each view
// is picked from the URL hash like the admin panel. Members see only their own
// team's enquiries; the server enforces that on every request.
import '../../styles/tokens.css';
import '../../styles/ambient.css';
import '../../styles/site.css';
import '../../styles/admin.css';
import '../../styles/admin-insights.css';
import '../../styles/team.css';
import ThemeButton from '../site/ThemeButton.astro';

interface Props { line: 'agri' | 'pack' }
const { line } = Astro.props;
const pack = line === 'pack';
const teamName = pack ? 'Packaging' : 'Agriculture';

const icon: Record<string, string> = {
  inbox: '<path d="M4 13h4l2 3h4l2-3h4"/><path d="M5.5 5h13L21 13v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6z"/>',
  followups: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  quotes: '<path d="M7 3h7l5 5v12a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  mockups: '<path d="M6 8h12l1.2 12.5a1 1 0 01-1 1.1H5.8a1 1 0 01-1-1.1z"/><path d="M9 8V6.5a3 3 0 016 0V8"/>',
  account: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/>',
};
const nav = [
  ['inbox', 'Inbox'], ['followups', 'Follow-ups'], ['quotes', 'Quotes'],
  ...(pack ? [['mockups', 'Mockups']] : []),
  ['account', 'My account'],
];
const Svg = (name: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<script is:inline>(function(){try{var s=localStorage.getItem('olira-theme');if(s==='dark'||s==='light')document.documentElement.setAttribute('data-theme',s);}catch(e){}})();</script>
<title>{teamName} workspace, Olira</title>
<link rel="icon" type="image/png" href="/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
</head>
<body class="admin-body team-body" data-line={line}>
<a class="skip" href="#teamMain">Skip to content</a>

<header class="a-top">
  <a class="a-brand" href={`/team/${pack ? 'packaging' : 'agriculture'}/`}><img src="/logo.png" alt="Olira" width="68" height="32" data-brand-logo><span>{teamName} workspace</span></a>
  <div class="a-top-actions">
    <span class="t-user" id="teamUser" hidden></span>
    <ThemeButton />
    <a class="btn btn-secondary" id="backToAdmin" href="/admin/#enquiries" hidden>Back to admin</a>
    <button class="btn btn-secondary" type="button" id="teamSignOut" hidden>Sign out</button>
  </div>
</header>

<!-- sign in -->
<main class="a-login" id="teamLogin" hidden>
  <form class="a-card a-login-card" id="teamLoginForm" novalidate>
    <div>
      <h1>{teamName} workspace</h1>
      <p>{pack ? 'Answer packaging requests, work with client files and prepare bag mockups.' : 'Accept and answer agriculture enquiries, and prepare quotes for buyers.'}</p>
    </div>
    <div class="a-field">
      <label for="tEmail">Work email</label>
      <input class="input" id="tEmail" name="email" type="email" autocomplete="username" required>
    </div>
    <div class="a-field">
      <label for="tPass">Password</label>
      <div class="a-pass">
        <input class="input" id="tPass" name="password" type="password" autocomplete="current-password" required aria-describedby="tLoginError">
        <button class="btn btn-ghost btn-sm" type="button" id="tTogglePass" aria-pressed="false">Show</button>
      </div>
      <p class="err" id="tLoginError" role="alert" hidden></p>
    </div>
    <button class="btn btn-primary btn-lg" type="submit">Sign in</button>
    <p class="a-note">The site administrator creates team accounts and resets passwords. Administrators can open this workspace from the admin panel.</p>
  </form>
</main>

<div class="a-shell t-shell" id="teamPanel" hidden>
  <nav class="a-side" aria-label="Workspace sections">
    <div class="a-side-group">
      <p>{teamName}</p>
      {nav.map(([id, label]) => (
        <a class="a-nav-link" href={`#${id}`} data-nav={id}>
          <Fragment set:html={Svg(id)} />{label}
          {(id === 'inbox' || id === 'followups') && <span class="a-count" data-count={id} hidden></span>}
        </a>
      ))}
    </div>
  </nav>

  <main id="teamMain" tabindex="-1">
    <!-- INBOX -->
    <section class="a-view" data-view="inbox" aria-labelledby="h-inbox" hidden>
      <div class="t-inbox-head">
        <h1 id="h-inbox">Inbox</h1>
        <ul class="t-summary" id="inboxKpis" aria-label="Your numbers"></ul>
        <button class="btn btn-ghost btn-sm" type="button" id="inboxRefresh">Refresh</button>
      </div>
      <div class="a-card t-toolbar">
        <div class="a-seg" role="radiogroup" aria-label="Show">
          <label><input type="radio" name="inboxFilter" value="unassigned" checked><span>To accept <b data-filter-count="unassigned"></b></span></label>
          <label><input type="radio" name="inboxFilter" value="mine"><span>Mine <b data-filter-count="mine"></b></span></label>
          <label><input type="radio" name="inboxFilter" value="open"><span>All open <b data-filter-count="open"></b></span></label>
          <label><input type="radio" name="inboxFilter" value="closed"><span>Closed <b data-filter-count="closed"></b></span></label>
        </div>
        <div class="t-toolbar-row">
          <label class="sr-only" for="inboxSearch">Search enquiries</label>
          <input class="input grow" id="inboxSearch" type="search" placeholder="Search name, company, email or message">
          <label class="sr-only" for="inboxSort">Sort</label>
          <select class="input" id="inboxSort">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="score">Strongest leads first</option>
          </select>
        </div>
        <p class="sr-only" id="inboxSummary" role="status" aria-live="polite"></p>
      </div>
      <div class="t-inbox">
        <ul class="t-list" id="inboxList" aria-label="Enquiries"></ul>
        <article class="t-detail a-card" id="leadDetail" aria-live="off">
          <div class="a-empty"><strong>Choose an enquiry</strong>{pack ? 'Accept one to make it yours, then reply, send a mockup and quote.' : 'Accept one to make it yours, then reply and quote.'}</div>
        </article>
      </div>
    </section>

    <!-- FOLLOW-UPS -->
    <section class="a-view" data-view="followups" aria-labelledby="h-followups" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-followups">Follow-ups</h1>
          <p>Enquiries that are waiting on you. Buyers who hear back within a day are far more likely to order, so start at the top.</p>
        </div>
      </div>
      <div id="followupList" class="t-follow"></div>
    </section>

    <!-- QUOTES -->
    <section class="a-view" data-view="quotes" aria-labelledby="h-quotes" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-quotes">Quotes</h1>
          <p>Every quote saved on an enquiry, newest first. Open one to follow up, or print it again.</p>
        </div>
      </div>
      <div class="a-card"><div class="a-scroll" id="quoteTable"></div></div>
    </section>

    {pack && (
      <section class="a-view" data-view="mockups" aria-labelledby="h-mockups" hidden>
        <div class="a-head">
          <div>
            <h1 id="h-mockups">Mockups</h1>
            <p>Put a client's logo on any of our bags, download the picture, or save it to their enquiry to send with a reply.</p>
          </div>
        </div>
        <div class="studio t-studio">
          <div class="a-card stage">
            <canvas class="stage-canvas" id="tmCanvas" width="1200" height="1680" tabindex="0" role="img" aria-label="Bag mockup preview" aria-describedby="tmInfo tmHelp"></canvas>
            <div class="stage-meta">
              <span class="note" id="tmHelp">Drag the design on the bag, or focus the preview and use the arrow keys.</span>
              <span class="note" id="tmInfo"></span>
            </div>
          </div>
          <div class="a-card panel">
            <p class="sr-only" id="tmStatus" role="status" aria-live="polite"></p>
            <div class="a-field">
              <label for="tmLead">For enquiry</label>
              <select class="input" id="tmLead"><option value="">No enquiry, just a picture</option></select>
            </div>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Bag</legend>
              <div class="chips" id="tmBags"></div>
            </fieldset>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Size</legend>
              <div class="chips">
                <label class="opt"><input type="radio" name="tmSize" value="small"><span>Small</span></label>
                <label class="opt"><input type="radio" name="tmSize" value="medium" checked><span>Medium</span></label>
                <label class="opt"><input type="radio" name="tmSize" value="large"><span>Large</span></label>
              </div>
            </fieldset>
            <div class="a-field">
              <span class="a-label" id="tmLogoLabel">Logo</span>
              <div class="t-logo-sources">
                <label class="a-drop" id="tmDrop">
                  <input type="file" id="tmLogoFile" accept="image/png,image/jpeg,image/svg+xml,image/webp" aria-labelledby="tmLogoLabel tmDropTitle">
                  <strong id="tmDropTitle">Upload a logo</strong>
                  <span>PNG, JPG, SVG or WebP from your computer.</span>
                </label>
                <div class="a-field" id="tmFromLeadWrap" hidden>
                  <label for="tmFromLead">Or use a file the client sent</label>
                  <select class="input" id="tmFromLead"></select>
                </div>
              </div>
              <div class="row" style="justify-content:space-between;--gap:10px;flex-wrap:wrap">
                <label class="a-check"><input type="checkbox" id="tmOneInk"> Print the logo in the ink colour</label>
                <button class="btn btn-ghost btn-sm" type="button" id="tmRemoveLogo" hidden>Remove logo</button>
              </div>
            </div>
            <div class="a-two">
              <div class="a-field"><label for="tmText1">Main text</label><input class="input" id="tmText1" maxlength="18" autocomplete="off"></div>
              <div class="a-field"><label for="tmText2">Second line</label><input class="input" id="tmText2" maxlength="28" autocomplete="off"></div>
            </div>
            <fieldset class="a-fieldset a-field">
              <legend class="a-label">Ink colour</legend>
              <div class="chips">
                <label class="opt opt-swatch" title="Black"><input type="radio" name="tmInk" value="black"><span style="--sw:#1E1B16"></span><b class="sr-only">Black</b></label>
                <label class="opt opt-swatch" title="Teal"><input type="radio" name="tmInk" value="teal" checked><span style="--sw:#186078"></span><b class="sr-only">Teal</b></label>
                <label class="opt opt-swatch" title="Leaf green"><input type="radio" name="tmInk" value="leaf"><span style="--sw:#4A5E17"></span><b class="sr-only">Leaf green</b></label>
                <label class="opt opt-swatch" title="Red"><input type="radio" name="tmInk" value="red"><span style="--sw:#A3301E"></span><b class="sr-only">Red</b></label>
                <label class="opt opt-swatch" title="White"><input type="radio" name="tmInk" value="white"><span style="--sw:#FAF7F0"></span><b class="sr-only">White</b></label>
              </div>
            </fieldset>
            <div class="a-field">
              <label for="tmScale">Design size</label>
              <input class="range" id="tmScale" type="range" min="50" max="140" value="100" aria-valuetext="100 percent">
            </div>
            <div class="row" style="--gap:8px;flex-wrap:wrap">
              <button class="btn btn-secondary btn-sm" type="button" id="tmCentre">Centre design</button>
            </div>
            <div class="panel-actions">
              <button class="btn btn-secondary" type="button" id="tmDownloadPng">Download PNG</button>
              <button class="btn btn-secondary" type="button" id="tmDownloadJpg">Download JPG</button>
            </div>
            <button class="btn btn-primary btn-lg" type="button" id="tmSave" disabled>Save to the enquiry</button>
            <p class="a-note" id="tmSaveNote">Choose an enquiry above to save the mockup to it. Saved mockups can be attached to a reply.</p>
          </div>
        </div>
      </section>
    )}

    <!-- ACCOUNT -->
    <section class="a-view" data-view="account" aria-labelledby="h-account" hidden>
      <div class="a-head">
        <div>
          <h1 id="h-account">My account</h1>
          <p>Buyers' replies to the emails you send from here go to your work email.</p>
        </div>
      </div>
      <div class="a-two" style="align-items:start">
        <div class="a-card">
          <h2>Signed in as</h2>
          <dl class="t-profile" id="accountProfile"></dl>
        </div>
        <form class="a-card a-form" id="accountPassForm" novalidate>
          <h2>Change password</h2>
          <div class="a-field"><label for="apCurrent">Current password</label><input class="input" id="apCurrent" type="password" autocomplete="current-password" required></div>
          <div class="a-field"><label for="apNew">New password</label><input class="input" id="apNew" type="password" autocomplete="new-password" minlength="12" required aria-describedby="apHint"><p class="hint" id="apHint">At least 12 characters.</p></div>
          <div class="a-field"><label for="apNew2">Type it again</label><input class="input" id="apNew2" type="password" autocomplete="new-password" required aria-describedby="apErr"><p class="err" id="apErr" role="alert" hidden></p></div>
          <div class="a-actions"><button class="btn btn-primary btn-lg" type="submit">Change password</button></div>
        </form>
      </div>
    </section>
  </main>
</div>

<!-- printable quote, filled in by quote.js -->
<div class="t-print" id="printSheet" aria-hidden="true"></div>

<div class="a-toasts" id="toasts" role="status" aria-live="polite"></div>
<dialog class="a-dialog" id="confirmDialog" aria-labelledby="confirmTitle">
  <form method="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmBody"></p>
    <div class="a-actions">
      <button class="btn btn-secondary" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="ok" id="confirmOk">Delete</button>
    </div>
  </form>
</dialog>

<script>import '../../scripts/team/main.js';</script>
</body>
</html>
