---

<div class:list={["social-links hidden items-center gap-3", className]} data-social-container>
  {label && (
    <span class={`font-sans text-[10px] tracking-[0.2em] uppercase font-semibold ${labelClasses} mr-2`}>{label}</span>
  )}
  {platforms.map((p) => (
    <a
      data-social={p.key}
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={p.label}
      class={`hidden w-10 h-10 rounded-full border ${iconClasses} transition-colors items-center justify-center`}
    >
      <svg width={p.size} height={p.size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={p.path} /></svg>
    </a>
  ))}
</div>

<script>
  // Hydrate every SocialLinks instance on the page from a single request. Reveal
  // only the icons whose URL is configured; hide the whole row if none are.
  (async function hydrateSocialLinks() {
    const rows = document.querySelectorAll('[data-social-container]');
    if (!rows.length) return;
    let links = {};
    try {
      const res = await fetch('/api/social-links');
      if (res.ok) links = await res.json();
    } catch (e) { /* leave rows hidden on failure — no dead icons */ }

    rows.forEach((row) => {
      let anyVisible = false;
      row.querySelectorAll('[data-social]').forEach((a) => {
        const url = links[a.getAttribute('data-social')];
        if (url) {
          a.setAttribute('href', url);
          a.classList.remove('hidden');
          a.classList.add('inline-flex');
          anyVisible = true;
        }
      });
      if (anyVisible) {
        row.classList.remove('hidden');
        row.classList.add('flex', 'flex-wrap');
      }
    });
  })();
</script>
