---
// SocialLinks.astro — clickable official social-media icons that link to the
// brand's profiles. URLs are managed in the admin "Social" tab and served from
// /api/social-links; each icon stays hidden until a URL is configured, so no
// dead links ever show. One <script> hydrates EVERY instance on the page from a
// single fetch (Astro bundles a component's script once regardless of reuse),
// so the footer and the homepage share one request.
export interface Props {
  label?: string;               // small eyebrow text, e.g. "Connect" / "Follow us"
  theme?: 'dark' | 'light';     // dark = on dark footer, light = on white sections
  class?: string;               // extra classes on the container
}
const { label = 'Connect', theme = 'light', class: className = '' } = Astro.props;

const iconClasses = theme === 'dark'
  ? 'border-primary-700 text-white hover:bg-white hover:text-primary-900'
  : 'border-primary-200 text-primary-700 hover:bg-primary-900 hover:text-white hover:border-primary-900';
const labelClasses = theme === 'dark' ? 'text-primary-300' : 'text-primary-500';

// Official brand marks (single-path SVGs, currentColor so they inherit theme).
const platforms = [
