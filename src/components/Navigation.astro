---
// Navigation.astro - Modern minimalist design inspired by MNTN
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo: scrolls to top -->
    <button
      class="flex items-center gap-3 scroll-to-top bg-transparent border-none p-0 cursor-pointer transition-opacity hover:opacity-75"
      aria-label="Scroll to top"
    >
      <!-- Astro Image: auto-optimized to WebP with hashed filename + cache headers.
           Admin can override via localStorage by setting #header-logo src at runtime
           (BaseLayout's loadAndApplyLogos handles that). -->
      <Image
        id="header-logo"
        src={logo}
        alt="Olira"
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="h-12 w-auto"
      />
    </button>

    <!-- Desktop Menu — anchor links with animated underline-on-hover -->
    <div class="hidden md:flex items-center gap-10">
      <a href="#products" class="nav-link text-primary-900 font-medium transition-colors">Products</a>
      <a href="#about" class="nav-link text-primary-900 font-medium transition-colors">About</a>
    </div>

    <!-- Contact Button -->
    <button id="contactBtn" class="hidden sm:block bg-primary-900 hover:bg-primary-800 text-white px-6 py-3 font-semibold tracking-wide transition-colors">
      Contact us
    </button>

    <!-- Mobile Menu Button: animated hamburger ↔ X -->
    <button id="menu-btn" class="md:hidden p-2 relative w-10 h-10" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-line block absolute left-2 right-2 h-0.5 bg-primary-900 transition-transform duration-300" style="top: 14px"></span>
      <span class="hamburger-line block absolute left-2 right-2 h-0.5 bg-primary-900 transition-opacity duration-300" style="top: 19px"></span>
      <span class="hamburger-line block absolute left-2 right-2 h-0.5 bg-primary-900 transition-transform duration-300" style="top: 24px"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
    <div class="px-6 py-6 space-y-4">
      <a href="#products" class="block text-primary-900 hover:text-primary-700 font-medium">PRODUCTS</a>
      <a href="#about" class="block text-primary-900 hover:text-primary-700 font-medium">ABOUT</a>
      <button id="mobileContactBtn" class="w-full block bg-primary-600 text-white px-6 py-3 font-bold text-center hover:bg-primary-800 transition">
        CONTACT US
      </button>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('nav');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const scrollToTopBtn = document.querySelector('.scroll-to-top');
  const contactBtn = document.getElementById('contactBtn');
  const mobileContactBtn = document.getElementById('mobileContactBtn');

  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuBtn?.classList.toggle('is-open', open);
  });

  // Close mobile menu when a link is clicked
  const mobileLinks = mobileMenu?.querySelectorAll('a, button');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // Open contact modal (uses modal component's openContactModal function)
  function handleContactClick() {
    if (typeof (window as any).openContactModal === 'function') {
      (window as any).openContactModal();
    }
  }

  contactBtn?.addEventListener('click', handleContactClick);
  mobileContactBtn?.addEventListener('click', handleContactClick);

  // Scroll to top when OLIRA logo is clicked
  scrollToTopBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Scroll-based nav enhancement
  let lastScrollY = 0;
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    if (scrollY > 100) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }

    lastScrollY = scrollY;
  });

</script>

<style>
  nav {
    backdrop-filter: blur(10px);
    background-color: rgba(255, 255, 255, 0.95);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav.scrolled {
    background-color: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 12px rgba(10, 20, 7, 0.08);
  }

  /* Nav link: animated underline grows from left on hover */
  .nav-link {
    position: relative;
    padding: 0.25rem 0;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background-color: #39572f;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    width: 100%;
  }

  /* Hamburger → X transform */
  #menu-btn.is-open .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  #menu-btn.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #menu-btn.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>
