---
// Footer.astro — high trust density for B2B importers.
// What Outfit doesn't need but Olira does: founders, address, certifications, year.
import Icon from './Icons.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-primary-900 text-white pt-20 pb-10">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Brand block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16 pb-16 border-b border-primary-800">
      <!-- Logo + statement -->
      <div class="lg:col-span-5">
        <!-- White rounded chip behind the logo so the colored mark stays
             readable on the dark green footer background. -->
        <div class="inline-flex items-center justify-center bg-white rounded-lg p-3 mb-6">
          <Image
            id="footer-logo"
            src={logo}
            alt="Olira Agro Industry"
            densities={[1, 2]}
            loading="lazy"
            class="h-14 w-auto"
          />
        </div>
        <p class="font-heading text-2xl font-bold text-white leading-snug mb-4 max-w-md">
          Premium agricultural exports from Ethiopia.
        </p>
        <p class="text-sm text-primary-100 leading-relaxed max-w-md">
          Founded 2008 by two Ethiopian agronomists with over 50 years of combined expertise in agricultural processing and international trade.
        </p>
      </div>

      <!-- Navigate -->
      <div class="lg:col-span-2">
        <h4 class="font-sans text-[10px] tracking-[0.2em] uppercase font-semibold mb-5 text-primary-300">Navigate</h4>
        <ul class="space-y-3 text-sm text-white">
          <li><a href="#products" class="hover:text-primary-100 transition-colors">Products</a></li>
          <li><a href="#about" class="hover:text-primary-100 transition-colors">About</a></li>
          <li><a href="#contact" class="hover:text-primary-100 transition-colors">Contact</a></li>
          <li><a href="/admin" class="hover:text-primary-100 transition-colors">Admin login</a></li>
        </ul>
      </div>

      <!-- Certifications -->
      <div class="lg:col-span-2">
        <h4 class="font-sans text-[10px] tracking-[0.2em] uppercase font-semibold mb-5 text-primary-300">Standards</h4>
        <ul class="space-y-3 text-sm text-white">
          <li>ISO 22000:2018</li>
          <li>GMP Certified</li>
          <li>Organic Certified</li>
          <li>Export Licensed</li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h4 class="font-sans text-[10px] tracking-[0.2em] uppercase font-semibold mb-5 text-primary-300">Get in touch</h4>
        <div class="space-y-4 text-sm text-white">
          <a href="tel:+251911223619" class="flex items-start gap-3 hover:text-primary-100 transition-colors">
            <Icon name="phone" size={16} class="flex-shrink-0 mt-0.5" />
            <span>+251 911 223 619</span>
          </a>
          <!-- Click copies email to clipboard. Microcopy makes the affordance honest. -->
          <button type="button" class="email-button group flex items-start gap-3 hover:text-primary-100 transition-colors text-left" data-email="info@oliraagroindustry.com">
            <Icon name="email" size={16} class="flex-shrink-0 mt-0.5" />
            <span class="flex flex-col items-start">
              <span class="email-text">info@oliraagroindustry.com</span>
              <span class="text-[10px] text-primary-300 uppercase tracking-[0.15em] mt-0.5 group-hover:text-primary-100">Click to copy</span>
            </span>
          </button>
          <div class="flex items-start gap-3">
            <Icon name="location" size={16} class="flex-shrink-0 mt-0.5" />
            <address class="not-italic leading-relaxed">
              Soreti Building, 2nd floor<br/>
              Lemi Kura Subcity, Woreda 08<br/>
              P.O. Box 46325<br/>
              Addis Ababa, Ethiopia
            </address>
          </div>
        </div>
      </div>
    </div>

    <!-- Social icons — shared component, hidden per-platform until a URL is set
         in the admin Social tab (served from /api/social-links). -->
    <SocialLinks theme="dark" label="Connect" class="mb-10 pb-10 border-b border-primary-800" />

    <!-- Legal row -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 text-xs text-primary-200">
      <p>© <span id="year"></span> Olira Agro Industry · All rights reserved</p>
      <p>Processing facility · Burayu, Oromia Region · 15 km west of Addis Ababa</p>
    </div>
  </div>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();

    // Social icons are hydrated by the shared SocialLinks component.

    document.querySelectorAll('.email-button').forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const email = button.getAttribute('data-email');
        const target = button.querySelector('.email-text') || button.querySelector('span');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(email).then(() => {
            const original = target.textContent;
            target.textContent = '✓ Copied!';
            setTimeout(() => { target.textContent = original; }, 2000);
          });
        } else {
          window.location.href = `mailto:${email}`;
        }
      });
    });
  </script>
</footer>
