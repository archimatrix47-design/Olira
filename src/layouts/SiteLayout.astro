---
// Public site layout (home, agriculture, packaging, 404). The admin panel
// (src/pages/admin.astro) uses the same stylesheets plus admin.css.
import '../styles/tokens.css';
import '../styles/ambient.css';
import '../styles/site.css';
import { SITE } from '../lib/site-data';

interface Props {
  title: string;
  description: string;
  /** Social preview image in /public, e.g. "/og-home.jpg". */
  ogImage?: string;
  ogImageAlt?: string;
  bodyClass?: string;
  /** One or more schema.org objects. */
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, ogImage = '/og-home.jpg', ogImageAlt = 'Olira Agro Industry', bodyClass, jsonLd, noindex = false } = Astro.props;
const url = `${SITE}${Astro.url.pathname}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>(function(){try{var s=localStorage.getItem('olira-theme');if(s==='dark'||s==='light')document.documentElement.setAttribute('data-theme',s);}catch(e){}})();</script>
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={url}>}
<meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111412" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Olira Agro Industry">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}${ogImage}`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${SITE}${ogImage}`}>
{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<link rel="icon" type="image/png" href="/logo.png">
<slot name="head" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<script is:inline>
  // Google Analytics and Google Ads, only when an ID is saved in the admin panel
  // (Marketing tags). No third-party request is made otherwise.
  window.gtag = window.gtag || function () {};
  window.trackConversion = window.trackConversion || function () {};
  fetch('/api/integrations').then(function (r) { return r.ok ? r.json() : null; }).then(function (c) {
    if (!c) return;
    var ga = c.analytics && c.analytics.measurementId;
    var aw = c.ads && /^d{10}$/.test(c.ads.conversionId || '') ? 'AW-' + c.ads.conversionId : '';
    if (!/^G-[A-Z0-9]{10}$/.test(ga || '')) ga = '';
    if (!ga && !aw) return;
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + (ga || aw); document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    gtag('js', new Date());
    if (ga) gtag('config', ga);
    if (aw) {
      gtag('config', aw);
      window.trackConversion = function () {
        gtag('event', 'conversion', {
          send_to: c.ads.conversionLabel ? aw + '/' + c.ads.conversionLabel : aw,
          value: Number(c.ads.conversionValue) || 1, currency: 'USD', transaction_id: 'inquiry_' + Date.now()
        });
      };
    }
  }).catch(function () {});
</script>
</head>
<body class={bodyClass}>
<a class="skip" href="#main">Skip to content</a>
<slot />
<script is:inline>
  // First-party analytics: no cookies, no third party, nothing stored in the
  // browser. The server counts visitors with a salted hash that changes daily.
  // Sent: the page, where the visit came from (referrer host, utm_ tags), the
  // browser language, and when leaving, how long the page was visible and how
  // far it was scrolled. window.oliraTrack(name) records an action.
  (function () {
    try {
      var send = function (body) {
        try { fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), keepalive: true }).catch(function () {}); } catch (e) {}
      };
      var q = new URLSearchParams(location.search), utm = {};
      ['source', 'medium', 'campaign'].forEach(function (k) { var v = q.get('utm_' + k); if (v) utm[k] = v.slice(0, 60); });
      send({ path: location.pathname, referrer: document.referrer || '', utm: utm, lang: String(navigator.language || '').slice(0, 10) });
      window.oliraTrack = function (event, data) {
        var body = { event: event, path: location.pathname };
        for (var k in data || {}) body[k] = data[k];
        send(body);
      };
      var visibleMs = 0, since = document.visibilityState === 'visible' ? Date.now() : 0, deepest = 0, sent = false;
      var measure = function () {
        var h = document.documentElement;
        var p = ((window.scrollY + window.innerHeight) / Math.max(h.scrollHeight, 1)) * 100;
        if (p > deepest) deepest = Math.min(100, p);
      };
      addEventListener('scroll', measure, { passive: true });
      addEventListener('load', measure);
      var leave = function () {
        if (since) { visibleMs += Date.now() - since; since = 0; }
        if (sent) return;
        sent = true;
        send({ event: 'leave', path: location.pathname, seconds: Math.round(visibleMs / 1000), scroll: Math.round(deepest) });
      };
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') since = Date.now(); else leave();
      });
      addEventListener('pagehide', leave);
    } catch (e) {}
  })();
</script>
</body>
</html>
